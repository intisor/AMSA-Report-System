{
  "ConnectionStrings": {
    "AmsaReportingDb": "Server=(localdb)\\mssqllocaldb;Database=AmsaReportingDb;Trusted_Connection=true;"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AmSaApi": {
    "BaseUrl": "https://api-dev.amsa.ng",
    "AppId": "ReportingApp",
    "AppSecret": "YOUR_APP_SECRET_HERE",
    "RequestTimeoutSeconds": 30,
    "ResiliencePolicy": {
      "MaxRetryAttempts": 3,
      "DelayMilliseconds": 1000,
      "CircuitBreakerThreshold": 5,
      "CircuitBreakerDurationSeconds": 30
    }
  },
  "AllowedHosts": "*"
}
