{
  "ConnectionStrings": {
    "AmsaReportingDb": "Server=localhost;Database=AmsaReportingDb;Trusted_Connection=true;TrustServerCertificate=True;"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AMSAApi": {
    "BaseUrl": "https://localhost:7278",
    "AppId": "ReportingApp",
    "AppSecret": "test-secret-123",
    "ServiceAccountMkanId": 1,
    "RequestTimeoutSeconds": 300,
    "ResiliencePolicy": {
      "MaxRetryAttempts": 3,
      "DelayMilliseconds": 1000,
      "CircuitBreakerThreshold": 5,
      "CircuitBreakerDurationSeconds": 30
    }
  },
  "AllowedHosts": "*"
}
