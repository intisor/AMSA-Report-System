@using AMSAReportingSystem.Data.Entities
@using AMSAReportingSystem.Services
@inject CurrentUserReportService CurrentUserReportService
@inject AmsaDirectoryLookupCache DirectoryLookupCache

<div class="container">
    @if (IsLoading)
    {
        <div class="alert alert-info">Loading national board...</div>
    }
    else
    {
        <div class="alert alert-info">
            <h5 class="alert-heading mb-1">National Board - @CycleLabel</h5>
            <p class="mb-0">Acknowledge reports submitted by states and monitor nationwide status.</p>
        </div>

        @if (!string.IsNullOrWhiteSpace(Message))
        {
            <div class="alert @MessageClass">@Message</div>
        }

        <div class="row mb-3">
            <div class="col-md-3"><strong>Total:</strong> @Reports.Count</div>
            <div class="col-md-3"><strong>Awaiting National:</strong> @Reports.Count(r => r.Status == ReportStatus.SubmittedToNational)</div>
            <div class="col-md-3"><strong>Acknowledged:</strong> @Reports.Count(r => r.Status == ReportStatus.Acknowledged)</div>
            <div class="col-md-3"><strong>States:</strong> @Reports.Select(r => r.StateId).Distinct().Count()</div>
        </div>

        <div class="card">
            <div class="card-header">
                <h5 class="mb-0">National Review Queue</h5>
            </div>
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead>
                        <tr>
                            <th>State</th>
                            <th>Unit</th>
                            <th>Status</th>
                            <th>Forwarded By State</th>
                            <th style="min-width: 260px;">National Note</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Reports.Count == 0)
                        {
                            <tr><td colspan="6" class="text-center text-muted py-4">No national reports found in this cycle.</td></tr>
                        }
                        else
                        {
                            @foreach (var report in Reports)
                            {
                                <tr>
                                    <td>@GetStateName(report.StateId)</td>
                                    <td><strong>@GetUnitName(report.UnitId)</strong></td>
                                    <td><span class="badge @GetStatusBadge(report.Status)">@report.Status</span></td>
                                    <td>@(report.ApprovedByStateAt?.ToString("yyyy-MM-dd HH:mm") ?? "-")</td>
                                    <td>
                                        <input class="form-control form-control-sm"
                                               placeholder="Optional national note"
                                               @bind="NotesByReport[report.Id]" />
                                    </td>
                                    <td>
                                        @if (report.Status == ReportStatus.SubmittedToNational)
                                        {
                                            <button class="btn btn-sm btn-success" @onclick="() => Acknowledge(report.Id)">
                                                Acknowledge
                                            </button>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">No action</span>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

@code {
    [Parameter]
    public AuthContext? CurrentUser { get; set; }

    private bool IsLoading = true;
    private string CycleLabel = "Active Cycle";
    private string? Message;
    private string MessageClass = "alert-info";
    private List<Report> Reports = new();
    private Dictionary<int, string> NotesByReport = new();
    private Dictionary<int, string> UnitNamesById = new();
    private Dictionary<int, string> StateNamesById = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        IsLoading = true;
        try
        {
            var cycle = await CurrentUserReportService.EnsureActiveCycleAsync();
            CycleLabel = cycle.CycleMonth;
            Reports = await CurrentUserReportService.GetNationalReportsAsync(cycle.Id);
            NotesByReport = Reports.ToDictionary(r => r.Id, _ => string.Empty);
            await WarmReportNamesAsync();
        }
        catch (Exception ex)
        {
            SetMessage(ex.Message, false);
        }
        finally
        {
            IsLoading = false;
        }
    }

    private async Task Acknowledge(int reportId)
    {
        try
        {
            await CurrentUserReportService.AcknowledgeAtNationalAsync(reportId, NotesByReport.GetValueOrDefault(reportId));
            SetMessage($"Report #{reportId} acknowledged by national leadership.", true);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            SetMessage(ex.Message, false);
        }
    }

    private void SetMessage(string text, bool success)
    {
        Message = text;
        MessageClass = success ? "alert-success" : "alert-danger";
    }

    private string GetUnitName(int unitId) =>
        UnitNamesById.TryGetValue(unitId, out var name) ? name : $"Unit {unitId}";

    private string GetStateName(int stateId) =>
        StateNamesById.TryGetValue(stateId, out var name) ? name : $"State {stateId}";

    private async Task WarmReportNamesAsync()
    {
        var unitIds = Reports.Select(r => r.UnitId).Distinct().ToList();
        foreach (var unitId in unitIds)
        {
            UnitNamesById[unitId] = await DirectoryLookupCache.GetUnitNameAsync(unitId);
        }

        var stateIds = Reports.Select(r => r.StateId).Distinct().ToList();
        foreach (var stateId in stateIds)
        {
            StateNamesById[stateId] = await DirectoryLookupCache.GetStateNameAsync(stateId);
        }
    }

    private static string GetStatusBadge(ReportStatus status) => status switch
    {
        ReportStatus.Draft => "bg-secondary",
        ReportStatus.SubmittedToPresident => "bg-info",
        ReportStatus.RejectedByPresident => "bg-danger",
        ReportStatus.SubmittedToState => "bg-primary",
        ReportStatus.RejectedByState => "bg-danger",
        ReportStatus.SubmittedToNational => "bg-dark",
        ReportStatus.Acknowledged => "bg-success",
        _ => "bg-secondary"
    };
}
