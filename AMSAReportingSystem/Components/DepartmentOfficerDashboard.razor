                <div class="card state-card no-report shadow-sm">
                    <div class="card-body p-5">
                        <div class="empty-state">
                            <div class="empty-state-icon">
                                <i class="bi bi-inbox"></i>
                            </div>
                            <h4 class="empty-state-title">No Report Started</h4>
                            <p class="empty-state-text">You haven't created a report for <strong>@CycleLabel</strong> yet.</p>
                            <button class="btn btn-primary btn-create" @onclick="OpenCreateReportModal">
                                <i class="bi bi-plus-circle me-2"></i> Create Report
                            </button>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-lg-4">
                <div class="card shadow-sm">
                    <div class="card-header bg-info text-white">
                        <h6 class="mb-0"><i class="bi bi-lightbulb me-2"></i> Next Steps</h6>
                    </div>
                    <div class="card-body">
                        <ol class="small mb-0">
                            <li class="mb-2">Click "Create Report" button</li>
                            <li class="mb-2">Fill each department section</li>
                            <li class="mb-2">Mark sections as submitted</li>
                            <li>Submit complete report</li>
                        </ol>
                    </div>
                </div>
            </div>
        </div>
    };

    private RenderFragment RenderDraftExistsState() => __builder =>
    {
        <div class="row g-4">
            <div class="col-lg-8">
                <div class="card state-card draft shadow-sm mb-4">
                    <div class="card-header bg-warning text-dark">
                        <h5 class="mb-0"><i class="bi bi-pencil-square me-2"></i> Your Department Sections</h5>
                    </div>
                    <div class="card-body">
                        @if (AllowedDepartments.Count == 0)
                        {
                            <div class="alert alert-warning mb-0">
                                <i class="bi bi-exclamation-triangle"></i> No departments available.
                            </div>
                        }
                        else
                        {
                            <div class="section-selector">
                                @foreach (var dept in AllowedDepartments)
                                {
                                    var isSubmitted = CurrentReport?.DepartmentReports.Any(d => d.Department == dept && d.IsSubmitted) ?? false;
                                    <div class="section-card @(isSubmitted ? "submitted" : "")">
                                        <div class="section-icon">
                                            <i class="bi @GetDepartmentIcon(dept)"></i>
                                        </div>
                                        <div class="section-info">
                                            <h6>@GetDepartmentTitle(dept)</h6>
                                            <p>@GetDepartmentHint(dept)</p>
                                            <small class="status-badge @GetDepartmentStatusBadgeClass(dept)">
                                                @GetDepartmentStatusLabel(dept)
                                            </small>
                                        </div>
                                        <button class="btn btn-primary btn-sm" @onclick="() => EditDepartment(dept)">
                                            <i class="bi bi-pencil me-1"></i> Edit
                                        </button>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>

                @if (CanSubmitFullReport)
                {
                    <button class="btn btn-success btn-lg w-100" @onclick="OpenSubmitReportModal" disabled="@(SubmittedDepartments < TotalDepartments || IsLoading)">
                        <i class="bi bi-check2-circle me-2"></i> 
                        @if (SubmittedDepartments < TotalDepartments)
                        {
                            <span>Submit When All Sections Complete</span>
                        }
                        else
                        {
                            <span>Submit Report to Unit President</span>
                        }
                    </button>
                }
                else
                {
                    <div class="alert alert-info mb-0">
                        <i class="bi bi-info-circle me-2"></i>
                        Your role is to complete and submit your assigned department section(s). Unit leadership handles full report submission.
                    </div>
                }
            </div>

            <div class="col-lg-4">
                <div class="card state-card draft shadow-sm mb-4">
                    <div class="card-header bg-light">
                        <h6 class="mb-0"><i class="bi bi-graph-up me-2"></i> Progress</h6>
                    </div>
                    <div class="card-body">
                        <div class="progress mb-3" style="height: 12px;">
                            <div class="progress-bar" role="progressbar" style="width: @ProgressPercent%;" aria-valuenow="@ProgressPercent" aria-valuemin="0" aria-valuemax="100"></div>
                        </div>
                        <div class="progress-stat">
                            <div class="progress-stat-value">@ProgressPercent%</div>
                            <div class="progress-stat-label">Complete</div>
                        </div>
                        <hr />
                        <div class="progress-stat">
                            <div class="progress-stat-value">@SubmittedDepartments/@TotalDepartments</div>
                            <div class="progress-stat-label">Sections Submitted</div>
                        </div>
                    </div>
                </div>

                <div class="card state-card draft shadow-sm">
                    <div class="card-header bg-light">
                        <h6 class="mb-0"><i class="bi bi-clock-history me-2"></i>Recent Activity</h6>
                    </div>
                    <div class="card-body" style="max-height: 350px; overflow-y: auto;">
                        @if (RecentActivity.Count == 0)
                        {
                            <p class="text-muted text-center mb-0">No activity yet.</p>
                        }
                        else
                        {
                            <div class="activity-timeline">
                                @foreach (var item in RecentActivity)
                                {
                                    <div class="activity-item">
                                        <div class="activity-time">@item.At.ToString("MMM d, h:mm tt")</div>
                                        <div class="activity-message">@item.Message</div>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    };

