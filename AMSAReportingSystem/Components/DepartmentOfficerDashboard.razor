@using AMSAReportingSystem.Services
@using AMSAReportingSystem.Data.Entities
@inject NavigationManager Nav
@inject ReportAccessService ReportAccessService
@inject CurrentUserReportService CurrentUserReportService

<!-- Main Dashboard Container -->
<div class="dashboard-container">
    <!-- Toast Notifications -->
    <div class="toast-container position-fixed top-0 end-0 p-3" style="z-index: 11;">
        @if (IsLoading)
        {
            <div class="toast show" role="alert">
                <div class="toast-header bg-info text-white">
                    <i class="bi bi-hourglass-split me-2"></i>
                    <strong>Loading</strong>
                </div>
                <div class="toast-body">Dashboard is loading...</div>
            </div>
        }
        @if (!string.IsNullOrEmpty(ErrorMessage))
        {
            <div class="toast show" role="alert">
                <div class="toast-header bg-danger text-white">
                    <i class="bi bi-exclamation-circle me-2"></i>
                    <strong>Error</strong>
                    <button type="button" class="btn-close btn-close-white" @onclick="() => ErrorMessage = null"></button>
                </div>
                <div class="toast-body">@ErrorMessage</div>
            </div>
        }
        @if (!string.IsNullOrEmpty(SuccessMessage))
        {
            <div class="toast show" role="alert">
                <div class="toast-header bg-success text-white">
                    <i class="bi bi-check-circle me-2"></i>
                    <strong>Success</strong>
                    <button type="button" class="btn-close btn-close-white" @onclick="() => SuccessMessage = null"></button>
                </div>
                <div class="toast-body">@SuccessMessage</div>
            </div>
        }
    </div>

    <!-- Cycle Header Card -->
    <div class="row mb-4">
        <div class="col-md-12">
            <div class="card cycle-header shadow-sm">
                <div class="card-header bg-gradient-primary text-white py-3">
                    <div class="row align-items-center">
                        <div class="col-auto">
                            <i class="bi bi-calendar-event fs-4"></i>
                        </div>
                        <div class="col">
                            <h5 class="mb-0">Monthly Report Submission Portal</h5>
                        </div>
                    </div>
                </div>
                <div class="card-body">
                    <div class="row g-4">
                        <div class="col-md-6">
                            <div class="info-box info-box-cycle">
                                <div class="info-label text-muted">
                                    <i class="bi bi-calendar3"></i> Reporting Cycle
                                </div>
                                <div class="info-value">@CycleLabel</div>
                                <div class="info-subtext text-muted">
                                    <i class="bi bi-info-circle"></i> 
                                    <small>Period: @(CurrentCycle?.StartDate.ToString("MMM 1") ?? "-") - @(CurrentCycle?.EndDate.ToString("MMM d, yyyy") ?? "-")</small>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="info-box info-box-deadline">
                                <div class="info-label text-muted">
                                    <i class="bi bi-clock-history"></i> Submission Deadline
                                </div>
                                <div class="info-value">@DeadlineLabel</div>
                                @if (DaysLeft.HasValue)
                                {
                                    <div class="info-subtext">
                                        @if (DaysLeft.Value <= 0)
                                        {
                                            <span class="badge bg-danger">
                                                <i class="bi bi-exclamation-triangle-fill"></i> DEADLINE PASSED
                                            </span>
                                        }
                                        else if (DaysLeft.Value <= 3)
                                        {
                                            <span class="badge bg-warning text-dark">
                                                <i class="bi bi-exclamation-circle-fill"></i> @DaysLeft day(s) left
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success">
                                                <i class="bi bi-check-circle-fill"></i> @DaysLeft day(s) left
                                            </span>
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- State-Based Content -->
    @switch (CurrentState)
    {
        case DashboardState.NoReportExists:
            @RenderNoReportExistsState()
            break;

        case DashboardState.DraftExists:
            @RenderDraftExistsState()
            break;

        case DashboardState.Rejected:
            @RenderRejectedState()
            break;

        case DashboardState.SubmittedToPresident:
            @RenderSubmittedState()
            break;

        case DashboardState.Acknowledged:
            @RenderAcknowledgedState()
            break;
    }

    <div class="row mt-4">
        <div class="col-lg-4">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-light d-flex justify-content-between align-items-center">
                    <h6 class="mb-0"><i class="bi bi-journal-text me-2"></i>Report History</h6>
                    <button class="btn btn-sm btn-outline-primary" @onclick="ReloadReportHistoryAsync" disabled="@IsRetrievalLoading">
                        Refresh
                    </button>
                </div>
                <div class="card-body" style="max-height: 420px; overflow-y: auto;">
                    @if (IsRetrievalLoading)
                    {
                        <div class="text-center text-muted py-4">
                            <div class="spinner-border spinner-border-sm me-2" role="status"></div>
                            Loading reports...
                        </div>
                    }
                    else if (ReportHistory.Count == 0)
                    {
                        <p class="text-muted text-center mb-0">No reports available.</p>
                    }
                    else
                    {
                        <div class="section-selector">
                            @foreach (var report in ReportHistory)
                            {
                                <div class="section-card @(SelectedReport?.ReportId == report.ReportId ? "submitted" : string.Empty)">
                                    <div class="section-icon">
                                        <i class="bi bi-file-earmark-text"></i>
                                    </div>
                                    <div class="section-info">
                                        <h6>@report.CycleLabel</h6>
                                        <p>@report.Status</p>
                                        <small class="status-badge @(GetReportStatusBadgeClass(report.Status))">
                                            @report.SubmittedDepartments/@report.TotalDepartments submitted
                                        </small>
                                    </div>
                                    <button class="btn btn-primary btn-sm" @onclick="() => ViewReportAsync(report.ReportId)">
                                        <i class="bi bi-eye me-1"></i> View
                                    </button>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="col-lg-8">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-light d-flex justify-content-between align-items-center">
                    <h6 class="mb-0"><i class="bi bi-file-earmark-lock me-2"></i>Read Only Report</h6>
                    @if (SelectedReport is not null)
                    {
                        <small class="text-muted">@SelectedReport.CycleLabel</small>
                    }
                </div>
                <div class="card-body">
                    @if (IsSelectedReportLoading)
                    {
                        <div class="alert alert-info mb-0">Loading report details...</div>
                    }
                    else if (SelectedReport is null)
                    {
                        <div class="empty-state py-5">
                            <div class="empty-state-icon">
                                <i class="bi bi-folder2-open"></i>
                            </div>
                            <h4 class="empty-state-title">Select a report</h4>
                            <p class="empty-state-text mb-0">Choose a report from history to view its submitted data and activity.</p>
                        </div>
                    }
                    else
                    {
                        <div class="mb-3 d-flex flex-wrap gap-2 align-items-center">
                            <span class="badge bg-secondary">@SelectedReport.Status</span>
                            <span class="badge bg-light text-dark">Created @SelectedReport.CreatedAt.ToString("MMM d, yyyy")</span>
                            @if (SelectedReport.SubmittedAt.HasValue)
                            {
                                <span class="badge bg-info text-white">Submitted @SelectedReport.SubmittedAt.Value.ToString("MMM d, yyyy")</span>
                            }
                        </div>

                        @if (SelectedReportDetails is not null)
                        {
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <div class="info-box">
                                        <div class="info-label text-muted">Departments</div>
                                        <div class="info-value">@SelectedReportDetails.Departments.Count</div>
                                        <div class="info-subtext">@SelectedReportDetails.Departments.Count(d => d.IsSubmitted) submitted</div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="info-box">
                                        <div class="info-label text-muted">Activity Items</div>
                                        <div class="info-value">@SelectedReportDetails.ActivityLogs.Count</div>
                                        <div class="info-subtext">Most recent actions</div>
                                    </div>
                                </div>
                            </div>

                            <hr />

                            <div class="row g-3">
                                <div class="col-md-6">
                                    <h6>Department Data</h6>
                                    <div class="small">
                                        @foreach (var department in SelectedReportDetails.Departments)
                                        {
                                            <div class="d-flex justify-content-between border-bottom py-2">
                                                <span>@department.DepartmentName</span>
                                                <span class="badge @(department.IsSubmitted ? "bg-success" : "bg-warning text-dark")">
                                                    @(department.IsSubmitted ? "Submitted" : "Draft")
                                                </span>
                                            </div>
                                        }
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <h6>Activity Log</h6>
                                    <div class="activity-timeline" style="max-height: 260px; overflow-y: auto;">
                                        @foreach (var activity in SelectedReportDetails.ActivityLogs)
                                        {
                                            <div class="activity-item">
                                                <div class="activity-time">@activity.At.ToString("MMM d, h:mm tt")</div>
                                                <div class="activity-message">@ToReadableActivity(activity.Action)</div>
                                                @if (!string.IsNullOrWhiteSpace(activity.Notes))
                                                {
                                                    <div class="text-muted small">@activity.Notes</div>
                                                }
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Create Report Modal -->
@if (IsCreateReportModalOpen)
{
<div class="modal fade show d-block" id="createReportModal" tabindex="-1" aria-modal="true" role="dialog">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title">
                    <i class="bi bi-plus-circle"></i> Create New Report
                </h5>
                <button type="button" class="btn-close btn-close-white" @onclick="CloseCreateReportModal"></button>
            </div>
            <div class="modal-body">
                <p>You're about to create a new report for <strong>@CycleLabel</strong>.</p>
                <p class="text-muted">
                    <small>
                        <i class="bi bi-info-circle"></i> 
                        This report will contain all department sections. You can save progress and come back anytime before the deadline.
                    </small>
                </p>
                <div class="alert alert-info" role="alert">
                    <strong>Deadline:</strong> @DeadlineLabel
                    @if (DaysLeft.HasValue && DaysLeft > 0)
                    {
                        <span class="badge bg-warning ms-2">@DaysLeft day(s) remaining</span>
                    }
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" @onclick="CloseCreateReportModal">Cancel</button>
                <button type="button" class="btn btn-primary" @onclick="OnCreateReportConfirmedAsync" disabled="@IsLoading">
                    @if (IsLoading)
                    {
                        <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                        <span>Creating@("...")</span>
                    }
                    else
                    {
                        <i class="bi bi-check-circle"></i> <span>Create Report</span>
                    }
                </button>
            </div>
        </div>
    </div>
</div>
<div class="modal-backdrop fade show"></div>
}

<!-- Submit Report Modal -->
@if (IsSubmitReportModalOpen)
{
<div class="modal fade show d-block" id="submitReportModal" tabindex="-1" aria-modal="true" role="dialog">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-success text-white">
                <h5 class="modal-title">
                    <i class="bi bi-send"></i> Submit Report for Review
                </h5>
                <button type="button" class="btn-close btn-close-white" @onclick="CloseSubmitReportModal"></button>
            </div>
            <div class="modal-body">
                <p>You are about to submit your report to your unit president for review.</p>
                <div class="alert alert-warning" role="alert">
                    <strong><i class="bi bi-exclamation-circle"></i> Important:</strong>
                    <ul class="mb-0 mt-2">
                        <li>All departments must be marked as submitted</li>
                        <li>You won't be able to edit sections after submission</li>
                        <li>Your unit president will review and approve or request changes</li>
                    </ul>
                </div>
                <div class="form-group">
                    <label for="submissionNotes">Optional Notes for President:</label>
                    <textarea class="form-control" id="submissionNotes" rows="3" @bind="SubmissionNotes" placeholder="Any notes or clarifications..."></textarea>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" @onclick="CloseSubmitReportModal">Cancel</button>
                <button type="button" class="btn btn-success" @onclick="OnSubmitReportAsync" disabled="@(IsLoading || SubmittedDepartments < TotalDepartments)">
                    @if (IsLoading)
                    {
                        <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                        <span>Submitting@("...")</span>
                    }
                    else
                    {
                        <i class="bi bi-check2-circle"></i> <span>Submit Report</span>
                    }
                </button>
            </div>
        </div>
    </div>
</div>
<div class="modal-backdrop fade show"></div>
}

<!-- Styles -->
<style>
    .dashboard-container {
        animation: fadeIn 0.3s ease-in;
    }

    @@keyframes fadeIn {
        from { opacity: 0; transform: translateY(10px); }
        to { opacity: 1; transform: translateY(0); }
    }

    .bg-gradient-primary {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    }

    .cycle-header {
        border-left: 5px solid #667eea;
    }

    .info-box {
        padding: 20px;
        background: #f8f9fa;
        border-radius: 8px;
        border-left: 4px solid #667eea;
        transition: all 0.3s ease;
    }

    .info-box:hover {
        background: #f0f1f5;
        transform: translateY(-2px);
    }

    .info-box-cycle { border-left-color: #667eea; }
    .info-box-deadline { border-left-color: #ff6b6b; }

    .info-label {
        font-size: 12px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        margin-bottom: 8px;
    }

    .info-value {
        font-size: 24px;
        font-weight: 700;
        color: #2d3748;
        margin-bottom: 8px;
    }

    .info-subtext {
        font-size: 12px;
        color: #718096;
    }

    .section-selector {
        display: flex;
        flex-direction: column;
        gap: 12px;
    }

    .section-card {
        display: flex;
        align-items: center;
        gap: 15px;
        padding: 18px;
        border: 2px solid #e9ecef;
        border-radius: 10px;
        background: white;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        cursor: pointer;
    }

    .section-card:hover {
        border-color: #667eea;
        box-shadow: 0 8px 20px rgba(102, 126, 234, 0.15);
        transform: translateX(4px);
    }

    .section-card.submitted {
        background: #f0fdf4;
        border-color: #86efac;
    }

    .section-icon {
        font-size: 28px;
        color: #667eea;
        flex-shrink: 0;
        width: 50px;
        height: 50px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #f0f1f5;
        border-radius: 8px;
    }

    .section-card.submitted .section-icon {
        color: #22c55e;
        background: #dcfce7;
    }

    .section-info {
        flex: 1;
    }

    .section-info h6 {
        margin: 0 0 4px 0;
        font-weight: 600;
        color: #2d3748;
    }

    .section-info p {
        margin: 0 0 8px 0;
        font-size: 13px;
        color: #718096;
    }

    .status-badge {
        display: inline-block;
        padding: 4px 10px;
        border-radius: 20px;
        font-size: 11px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.3px;
    }

    .status-badge.draft {
        background: #fef3c7;
        color: #92400e;
    }

    .status-badge.submitted {
        background: #d1fae5;
        color: #065f46;
    }

    .progress-stat {
        text-align: center;
        padding: 15px 0;
    }

    .progress-stat-value {
        font-size: 28px;
        font-weight: 700;
        color: #667eea;
    }

    .progress-stat-label {
        font-size: 12px;
        color: #718096;
        margin-top: 4px;
    }

    .progress {
        background: #e9ecef;
        border-radius: 10px;
        overflow: hidden;
    }

    .progress-bar {
        background: linear-gradient(90deg, #667eea 0%, #764ba2 100%);
        transition: width 0.6s ease;
    }

    .activity-timeline {
        position: relative;
        padding-left: 20px;
    }

    .activity-item {
        padding: 12px 0;
        padding-left: 20px;
        border-left: 2px solid #e9ecef;
        position: relative;
        margin-bottom: 12px;
    }

    .activity-item::before {
        content: '';
        position: absolute;
        left: -8px;
        top: 16px;
        width: 12px;
        height: 12px;
        background: #667eea;
        border: 3px solid white;
        border-radius: 50%;
        box-shadow: 0 0 0 2px #e9ecef;
    }

    .activity-time {
        font-size: 11px;
        color: #a0aec0;
        font-weight: 600;
        text-transform: uppercase;
    }

    .activity-message {
        font-size: 13px;
        color: #2d3748;
        margin-top: 4px;
    }

    .btn-create {
        padding: 14px 32px;
        font-size: 16px;
        font-weight: 600;
        border-radius: 8px;
        transition: all 0.3s ease;
        box-shadow: 0 4px 12px rgba(102, 126, 234, 0.3);
    }

    .btn-create:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 20px rgba(102, 126, 234, 0.4);
    }

    .state-card {
        animation: slideIn 0.4s ease-in;
        border-left: 5px solid;
    }

    @@keyframes slideIn {
        from { opacity: 0; transform: translateY(20px); }
        to { opacity: 1; transform: translateY(0); }
    }

    .state-card.no-report { border-left-color: #60a5fa; }
    .state-card.draft { border-left-color: #fbbf24; }
    .state-card.submitted { border-left-color: #60a5fa; }
    .state-card.rejected { border-left-color: #f87171; }
    .state-card.acknowledged { border-left-color: #34d399; }

    .timeline-approval {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin: 30px 0;
    }

    .timeline-step {
        flex: 1;
        text-align: center;
        position: relative;
    }

    .timeline-step.completed .step-circle {
        background: #34d399;
        color: white;
    }

    .timeline-step.pending .step-circle {
        background: #e5e7eb;
        color: #9ca3af;
    }

    .step-circle {
        width: 50px;
        height: 50px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 600;
        margin: 0 auto 10px;
        transition: all 0.3s ease;
    }

    .step-label {
        font-size: 12px;
        font-weight: 600;
        color: #718096;
    }

    .empty-state {
        text-align: center;
        padding: 60px 20px;
    }

    .empty-state-icon {
        font-size: 64px;
        color: #cbd5e1;
        margin-bottom: 20px;
    }

    .empty-state-title {
        font-size: 24px;
        font-weight: 700;
        color: #2d3748;
        margin-bottom: 10px;
    }

    .empty-state-text {
        font-size: 16px;
        color: #718096;
        margin-bottom: 30px;
    }

    .toast-container .toast {
        margin-bottom: 10px;
    }
</style>

@code {
    private record ActivityItem(DateTime At, string Message);

    [Parameter]
    public AuthContext? CurrentUser { get; set; }

    private List<DepartmentType> AllowedDepartments { get; set; } = new();
    private string CycleLabel { get; set; } = "-";
    private string DeadlineLabel { get; set; } = "-";
    private int? DaysLeft { get; set; }
    private int TotalDepartments { get; set; }
    private int SubmittedDepartments { get; set; }
    private Report? CurrentReport { get; set; }
    private ReportingCycle? CurrentCycle { get; set; }
    private List<ActivityItem> RecentActivity { get; set; } = new();
    private List<ReportRetrievalSummary> ReportHistory { get; set; } = new();
    private ReportRetrievalSummary? SelectedReport { get; set; }
    private ReportRetrievalDetails? SelectedReportDetails { get; set; }
    private bool IsLoading { get; set; }
    private bool IsRetrievalLoading { get; set; }
    private bool IsSelectedReportLoading { get; set; }
    private string? ErrorMessage { get; set; }
    private string? SuccessMessage { get; set; }
    private string? SubmissionNotes { get; set; }
    private bool IsCreateReportModalOpen { get; set; }
    private bool IsSubmitReportModalOpen { get; set; }

    private enum DashboardState { NoReportExists, DraftExists, SubmittedToPresident, Rejected, Acknowledged }
    private DashboardState CurrentState { get; set; } = DashboardState.NoReportExists;

    private int ProgressPercent => TotalDepartments == 0 ? 0 : (int)Math.Round((SubmittedDepartments * 100.0) / TotalDepartments);
    private bool CanSubmitFullReport =>
        CurrentUser is not null &&
        (CurrentUser.IsUnitLeadership || CurrentUser.IsStateLeadership || CurrentUser.IsNationalLeadership || CurrentUser.HasSudoAccess);

    protected override async Task OnInitializedAsync()
    {
        AllowedDepartments = GetAllowedDepartments();
        await LoadSummaryAsync();
        await ReloadReportHistoryAsync();
    }

    private async Task LoadSummaryAsync()
    {
        if (CurrentUser is null || !CurrentUser.IsAuthenticated)
            return;

        IsLoading = true;
        ErrorMessage = null;

        try
        {
            CurrentCycle = await CurrentUserReportService.EnsureActiveCycleAsync();
            CycleLabel = CurrentCycle.CycleMonth;
            DeadlineLabel = CurrentCycle.SubmissionDeadline.ToString("MMMM d, yyyy");
            DaysLeft = (CurrentCycle.SubmissionDeadline.Date - DateTime.UtcNow.Date).Days;

            CurrentReport = await CurrentUserReportService.GetCurrentUserDraftAsync(CurrentCycle.Id);

            if (CurrentReport is null)
            {
                CurrentState = DashboardState.NoReportExists;
            }
            else
            {
                CurrentState = CurrentReport.Status switch
                {
                    ReportStatus.Draft => DashboardState.DraftExists,
                    ReportStatus.SubmittedToPresident or ReportStatus.SubmittedToState or ReportStatus.SubmittedToNational => DashboardState.SubmittedToPresident,
                    ReportStatus.RejectedByPresident or ReportStatus.RejectedByState => DashboardState.Rejected,
                    ReportStatus.Acknowledged => DashboardState.Acknowledged,
                    _ => DashboardState.NoReportExists
                };

                if (CurrentState == DashboardState.DraftExists || CurrentState == DashboardState.Rejected)
                {
                    TotalDepartments = CurrentReport.DepartmentReports.Count == 0 ? 9 : CurrentReport.DepartmentReports.Count;
                    SubmittedDepartments = CurrentReport.DepartmentReports.Count(d => d.IsSubmitted);
                    RecentActivity = CurrentReport.ActivityLogs
                        .OrderByDescending(log => log.ActionAt)
                        .Take(6)
                        .Select(log => new ActivityItem(log.ActionAt, ToReadableActivity(log.Action)))
                        .ToList();
                }
            }
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Error loading dashboard: {ex.Message}";
        }
        finally
        {
            IsLoading = false;
        }
    }

    private async Task ReloadReportHistoryAsync()
    {
        if (CurrentUser is null || !CurrentUser.IsAuthenticated)
            return;

        IsRetrievalLoading = true;

        try
        {
            ReportHistory = (await CurrentUserReportService.GetCurrentUserReportHistoryAsync()).ToList();
            if (SelectedReport is not null && ReportHistory.All(report => report.ReportId != SelectedReport.ReportId))
            {
                SelectedReport = null;
                SelectedReportDetails = null;
            }
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Error loading report history: {ex.Message}";
        }
        finally
        {
            IsRetrievalLoading = false;
        }
    }

    private async Task ViewReportAsync(int reportId)
    {
        IsSelectedReportLoading = true;
        SelectedReport = ReportHistory.FirstOrDefault(report => report.ReportId == reportId);
        SelectedReportDetails = null;

        try
        {
            SelectedReportDetails = await CurrentUserReportService.GetReportDetailsAsync(reportId);
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Error loading report details: {ex.Message}";
        }
        finally
        {
            IsSelectedReportLoading = false;
        }
    }

    private async Task OnCreateReportConfirmedAsync()
    {
        if (CurrentCycle is null || CurrentUser is null)
            return;

        IsLoading = true;
        ErrorMessage = null;

        try
        {
            CurrentReport = await CurrentUserReportService.CreateCurrentUserDraftAsync(CurrentCycle.Id);
            CurrentState = DashboardState.DraftExists;
            TotalDepartments = CurrentReport.DepartmentReports.Count == 0 ? 9 : CurrentReport.DepartmentReports.Count;
            SubmittedDepartments = 0;
            RecentActivity.Clear();
            SuccessMessage = $"Report created for {CycleLabel}. Start filling out your department sections!";
            CloseCreateReportModal();
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Error creating report: {ex.Message}";
        }
        finally
        {
            IsLoading = false;
        }
    }

    private async Task OnSubmitReportAsync()
    {
        if (CurrentReport is null || !CanSubmitFullReport || SubmittedDepartments < TotalDepartments)
            return;

        IsLoading = true;
        ErrorMessage = null;

        try
        {
            await CurrentUserReportService.SubmitReportToPresidentAsync(CurrentReport.Id, SubmissionNotes);
            CurrentReport.Status = ReportStatus.SubmittedToPresident;
            CurrentState = DashboardState.SubmittedToPresident;
            SuccessMessage = "Report submitted successfully to your unit president for review.";
            SubmissionNotes = null;
            CloseSubmitReportModal();
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Error submitting report: {ex.Message}";
        }
        finally
        {
            IsLoading = false;
        }
    }

    private void EditDepartment(DepartmentType department)
    {
        Nav.NavigateTo($"/report/{department.ToString().ToLowerInvariant()}");
    }

    private void OpenCreateReportModal() => IsCreateReportModalOpen = true;
    private void CloseCreateReportModal() => IsCreateReportModalOpen = false;
    private void OpenSubmitReportModal() => IsSubmitReportModalOpen = true;
    private void CloseSubmitReportModal() => IsSubmitReportModalOpen = false;

    private static string GetReportStatusBadgeClass(ReportStatus status) => status switch
    {
        ReportStatus.Draft => "draft",
        ReportStatus.SubmittedToPresident or ReportStatus.SubmittedToState or ReportStatus.SubmittedToNational => "submitted",
        ReportStatus.RejectedByPresident or ReportStatus.RejectedByState => "draft",
        ReportStatus.Acknowledged => "submitted",
        _ => "draft"
    };

    private List<DepartmentType> GetAllowedDepartments()
    {
        if (CurrentUser is null || !CurrentUser.IsAuthenticated)
            return new();

        var allowed = new List<DepartmentType>();
        foreach (var department in ReportDepartmentCatalog.ReportableDepartments)
        {
            if (ReportAccessService.CanEditDepartment(CurrentUser, CurrentUser.UnitId, CurrentUser.StateId, department))
                allowed.Add(department);
        }
        return allowed;
    }

    private static string GetDepartmentTitle(DepartmentType department) => department switch
    {
        DepartmentType.Taleem => "Islamic Education (Taleem)",
        DepartmentType.Tabligh => "Preaching (Tabligh)",
        DepartmentType.Welfare => "Welfare",
        DepartmentType.Sport => "Sport",
        DepartmentType.Finance => "Finance",
        DepartmentType.Health => "Health",
        DepartmentType.SecondarySchool => "Secondary School",
        DepartmentType.Tajneed => "Tajneed",
        DepartmentType.General => "General",
        _ => department.ToString()
    };

    private static string GetDepartmentHint(DepartmentType department) => department switch
    {
        DepartmentType.Taleem => "Report on monthly education sessions and attendance",
        DepartmentType.Tabligh => "Report on preaching and outreach activities",
        DepartmentType.Welfare => "Report welfare and social service activities",
        DepartmentType.Sport => "Report sports and participation",
        DepartmentType.Finance => "Report collections and financial records",
        DepartmentType.Health => "Report health-related initiatives",
        DepartmentType.SecondarySchool => "Report secondary school outreach",
        DepartmentType.Tajneed => "Report member registry and follow-up",
        DepartmentType.General => "Report general activities and notes",
        _ => "Report department activities"
    };

    private string GetDepartmentStatusBadgeClass(DepartmentType department)
    {
        if (CurrentReport is null) return "draft";
        var dept = CurrentReport.DepartmentReports.FirstOrDefault(d => d.Department == department);
        return dept?.IsSubmitted == true ? "submitted" : "draft";
    }

    private string GetDepartmentStatusLabel(DepartmentType department)
    {
        if (CurrentReport is null) return "Not Started";
        var dept = CurrentReport.DepartmentReports.FirstOrDefault(d => d.Department == department);
        return dept?.IsSubmitted == true ? "Submitted" : "Not Submitted";
    }

    private string GetDepartmentIcon(DepartmentType department) => department switch
    {
        DepartmentType.Taleem => "bi-book",
        DepartmentType.Tabligh => "bi-megaphone",
        DepartmentType.Welfare => "bi-heart",
        DepartmentType.Sport => "bi-trophy",
        DepartmentType.Finance => "bi-cash-coin",
        DepartmentType.Health => "bi-hospital",
        DepartmentType.SecondarySchool => "bi-building",
        DepartmentType.Tajneed => "bi-people",
        DepartmentType.General => "bi-file-text",
        _ => "bi-list"
    };

    private static string ToReadableActivity(string action) => action switch
    {
        "ReportCreated" => "Report created",
        "ReportSubmittedToPresident" => "Report submitted to unit president",
        "ApprovedByUnitLeadership" => "Approved by unit leadership",
        "RejectedByUnitLeadership" => "Rejected by unit leadership",
        "DepartmentReportSubmitted" => "Department report submitted",
        "DepartmentReportSaved" => "Department report saved",
        _ => action
    };

    // Render methods for each state
