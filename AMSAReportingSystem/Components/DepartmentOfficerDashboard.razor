@using AMSAReportingSystem.Services
@using AMSAReportingSystem.Data.Entities
@using Microsoft.AspNetCore.Components
@inject NavigationManager Nav
@inject ReportAccessService ReportAccessService
@inject ReportingApiClient ReportingApiClient

<!-- Main Dashboard Container -->
<div class="flex flex-col gap-6 w-full animate-fadeIn max-w-7xl mx-auto pb-12">
    <!-- Toast Notifications -->
    <div class="fixed top-20 end-6 p-4 z-50 flex flex-col gap-3 max-w-sm w-full pointer-events-none">
        @if (IsLoading)
        {
            <div class="bg-surface-white border-l-4 border-info shadow-lg rounded-xl p-4 flex gap-3 items-center pointer-events-auto animate-pulse">
                <span class="material-symbols-outlined text-info text-2xl animate-spin">sync</span>
                <div>
                    <h5 class="font-bold text-sm text-on-surface">Loading</h5>
                    <p class="text-xs text-on-surface-variant">Dashboard is updating...</p>
                </div>
            </div>
        }
        @if (!string.IsNullOrEmpty(ErrorMessage))
        {
            <div class="bg-surface-white border-l-4 border-danger shadow-lg rounded-xl p-4 flex gap-3 items-start pointer-events-auto">
                <span class="material-symbols-outlined text-danger text-2xl">error</span>
                <div class="flex-1">
                    <h5 class="font-bold text-sm text-on-surface">Error</h5>
                    <p class="text-xs text-on-surface-variant">@ErrorMessage</p>
                </div>
                <button type="button" class="text-outline hover:text-on-surface" @onclick="CloseErrorMessage">
                    <span class="material-symbols-outlined text-lg">close</span>
                </button>
            </div>
        }
        @if (!string.IsNullOrEmpty(SuccessMessage))
        {
            <div class="bg-surface-white border-l-4 border-success shadow-lg rounded-xl p-4 flex gap-3 items-start pointer-events-auto">
                <span class="material-symbols-outlined text-success text-2xl">check_circle</span>
                <div class="flex-1">
                    <h5 class="font-bold text-sm text-on-surface">Success</h5>
                    <p class="text-xs text-on-surface-variant">@SuccessMessage</p>
                </div>
                <button type="button" class="text-outline hover:text-on-surface" @onclick="CloseSuccessMessage">
                    <span class="material-symbols-outlined text-lg">close</span>
                </button>
            </div>
        }
    </div>

    <!-- Cycle Header Card -->
    <div class="bg-surface-white rounded-2xl shadow-md border border-border-subtle p-6 flex flex-col lg:flex-row justify-between items-start lg:items-center gap-6">
        <div>
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-tertiary-fixed-dim bg-primary-light shadow-sm mb-3">
                <span class="material-symbols-outlined text-primary text-sm fill">badge</span>
                <span class="font-label-sm text-label-sm text-primary font-semibold">Local Unit Officer Portal</span>
            </div>
            <h1 class="font-headline-lg text-headline-lg text-primary">Assalamu Alaikum, @(CurrentUser?.FirstName ?? "Brother")! 👋</h1>
            <p class="font-body-md text-body-md text-on-surface-variant mt-1">Submit your monthly department sections and track unit progress.</p>
        </div>
        
        <div class="bg-bg-cream rounded-xl border border-border-subtle p-4 flex flex-col sm:flex-row items-start sm:items-center gap-4 w-full lg:max-w-md shadow-sm">
            <div class="flex items-center gap-3 bg-surface-white px-4 py-2 rounded-lg border border-border-subtle">
                <span class="material-symbols-outlined text-secondary text-2xl">calendar_month</span>
                <div>
                    <p class="font-label-sm text-[10px] text-on-surface-variant uppercase tracking-wider">Cycle Period</p>
                    <p class="font-label-md text-label-md text-on-surface font-bold">@CycleLabel</p>
                </div>
            </div>
            <div class="flex-1 w-full">
                <div class="flex items-center justify-between mb-1">
                    <span class="font-label-sm text-label-sm text-warning font-bold flex items-center gap-1.5 animate-pulse-glow">
                        <span class="relative flex h-2 w-2">
                            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-warning opacity-75"></span>
                            <span class="relative inline-flex rounded-full h-2 w-2 bg-warning"></span>
                        </span>
                        Deadline: @(CurrentCycle?.SubmissionDeadline.ToString("MMM d") ?? "-")
                    </span>
                    <span class="font-label-sm text-label-sm text-on-surface-variant">@(DaysLeft.HasValue ? $"{DaysLeft} Days Left" : "-")</span>
                </div>
                <div class="w-full bg-surface-variant rounded-full h-2 overflow-hidden">
                    <div class="bg-warning h-2 rounded-full transition-all duration-500" style="width: @(DaysLeft.HasValue && DaysLeft.Value <= 0 ? "100%" : DaysLeft.HasValue && DaysLeft.Value <= 3 ? "90%" : "50%")"></div>
                </div>
            </div>
        </div>
    </div>

    <!-- State-Based Content -->
    @if (CurrentState == DashboardState.NoReportExists)
    {
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
            <div class="lg:col-span-8 bg-surface-white rounded-2xl border border-border-subtle shadow-sm p-8 flex flex-col justify-center items-center text-center">
                <span class="material-symbols-outlined text-6xl text-border-subtle mb-4">folder_zip</span>
                <h4 class="font-headline-sm text-xl text-on-surface font-bold mb-2">No Active Report Found</h4>
                <p class="text-sm text-on-surface-variant max-w-sm mb-6">No report has been created for the active monthly cycle <strong>@CycleLabel</strong> yet. Click the button below to initialize the submissions record.</p>
                <button class="px-6 py-3 bg-gradient-to-r from-primary to-primary-container text-white rounded-xl font-semibold text-sm transition-all hover:shadow-lg shadow-md flex items-center gap-2 cursor-pointer border-0" @onclick="OpenCreateReportModal">
                    <span class="material-symbols-outlined">add_circle</span>
                    <span>Create Report Draft</span>
                </button>
            </div>
            
            <div class="lg:col-span-4 bg-surface-white rounded-2xl border border-border-subtle shadow-sm p-6">
                <h5 class="font-bold text-sm text-on-surface mb-3 border-b border-border-subtle pb-1">Submission Guide</h5>
                <ol class="text-xs text-on-surface-variant space-y-3 list-decimal pl-4">
                    <li>Initialize the active cycle report container by clicking "Create Report".</li>
                    <li>Open each department form and input monthly figures and activities.</li>
                    <li>Mark sections as "Submitted" to freeze input.</li>
                    <li>Submit the combined report for executive review.</li>
                </ol>
            </div>
        </div>
    }
    else if (CurrentState == DashboardState.DraftExists)
    {
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
            <!-- Left Column: Sections (8 cols) -->
            <div class="lg:col-span-8 flex flex-col gap-6">
                <div class="flex items-center justify-between border-b border-border-subtle pb-2">
                    <h2 class="font-headline-sm text-headline-sm text-on-surface font-bold">Monthly Department Report Cards</h2>
                    <span class="font-label-sm text-label-sm text-outline bg-surface-variant px-2.5 py-0.5 rounded">@AllowedDepartments.Count Sections</span>
                </div>
                
                <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-6">
                    @foreach (var dept in AllowedDepartments)
                    {
                        var isSubmitted = CurrentReport?.DepartmentReports.Any(d => d.Department == dept && d.IsSubmitted) ?? false;
                        var icon = GetDepartmentIcon(dept);
                        var badgeClass = isSubmitted ? "bg-success-bg text-success border border-success/15" : "bg-warning-bg text-warning border border-warning/15";
                        var iconBgClass = isSubmitted ? "bg-success-bg text-success" : "bg-warning-bg text-warning";
                        
                        <div class="bg-bg-cream rounded-2xl border border-border-subtle p-5 shadow-sm hover:-translate-y-1 hover:shadow-[0_8px_30px_0_rgba(197,168,128,0.25)] hover:bg-surface-white hover:border-tertiary-fixed-dim transition-all duration-300 group flex flex-col relative overflow-hidden z-0 cursor-pointer" @onclick="() => EditDepartment(dept)">
                            <!-- Heritage Watermark Accent -->
                            <div class="absolute -right-6 -bottom-6 w-24 h-24 text-tertiary-fixed-dim/20 pointer-events-none transition-transform duration-500 group-hover:rotate-12 group-hover:scale-110">
                                <svg fill="none" stroke="currentColor" stroke-width="4" viewbox="0 0 100 100" xmlns="http://www.w3.org/2000/svg">
                                    <polygon points="20,20 80,20 80,80 20,80"></polygon>
                                    <polygon points="50,5 95,50 50,95 5,50"></polygon>
                                </svg>
                            </div>
                            <div class="flex flex-col items-start mb-4 z-10">
                                <div class="w-10 h-10 rounded-full @iconBgClass flex items-center justify-center mb-3">
                                    <span class="material-symbols-outlined fill text-lg">@icon</span>
                                </div>
                                <h3 class="font-bold text-sm text-on-surface">@GetDepartmentTitle(dept)</h3>
                            </div>
                            <p class="font-body-sm text-body-sm text-on-surface-variant line-clamp-3 mb-6 flex-1 z-10">@GetDepartmentHint(dept)</p>
                            <div class="flex items-center justify-between mt-auto z-10">
                                <button class="py-1.5 px-3.5 rounded-lg bg-surface-white border border-border-subtle text-primary font-semibold text-xs hover:bg-primary hover:text-on-primary hover:border-primary transition-colors group-hover:shadow-sm">
                                    @(isSubmitted ? "Review" : "Continue")
                                </button>
                                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full @badgeClass font-label-sm text-[11px] font-bold uppercase tracking-wider">
                                    <span class="material-symbols-outlined text-[12px] mr-1">@(isSubmitted ? "check_circle" : "sync")</span>
                                    @(isSubmitted ? "Done" : "Draft")
                                </span>
                            </div>
                        </div>
                    }
                </div>
                
                <!-- Combined Submission Box -->
                @if (CanSubmitFullReport)
                {
                    <div class="p-6 bg-surface-white rounded-2xl border border-border-subtle shadow-sm flex flex-col sm:flex-row items-center justify-between gap-4">
                        <div>
                            <h3 class="font-headline-sm text-base text-on-surface font-bold">Ready for President's Review?</h3>
                            <p class="font-body-sm text-sm text-on-surface-variant mt-1">Make sure all assigned department sections are successfully finalized first.</p>
                        </div>
                        @if (SubmittedDepartments < TotalDepartments)
                        {
                            <button class="py-3 px-6 rounded-xl bg-surface-variant text-outline font-semibold text-sm flex items-center gap-2 cursor-not-allowed opacity-75 border-0" disabled>
                                <span class="material-symbols-outlined">lock</span>
                                <span>Submit Report Portal</span>
                            </button>
                        }
                        else
                        {
                            <button class="py-3 px-6 rounded-xl bg-success hover:bg-primary text-white font-semibold text-sm flex items-center gap-2 hover:shadow-lg transition-all cursor-pointer border-0" @onclick="OpenSubmitReportModal">
                                <span class="material-symbols-outlined">send</span>
                                <span>Submit Combined Report</span>
                            </button>
                        }
                    </div>
                }
            </div>
            
            <!-- Right Column: Progress & Timelines (4 cols) -->
            <div class="lg:col-span-4 flex flex-col gap-6">
                <!-- Progress Card -->
                <div class="bg-surface-white rounded-2xl border border-border-subtle shadow-sm p-6 relative overflow-hidden">
                    <div class="absolute -right-10 -top-10 w-32 h-32 bg-primary-light rounded-full opacity-50 blur-2xl"></div>
                    <h3 class="font-label-md text-xs text-on-surface-variant uppercase tracking-wider mb-4 font-bold">Progress Dashboard</h3>
                    <div class="flex items-end gap-2 mb-2">
                        <span class="font-headline-xl text-3xl text-primary leading-none">@SubmittedDepartments</span>
                        <span class="font-body-lg text-sm text-on-surface-variant pb-1">of @TotalDepartments Sections Ready</span>
                    </div>
                    <div class="flex items-center gap-3">
                        <div class="flex-1 bg-surface-variant rounded-full h-2 overflow-hidden">
                            <div class="bg-primary h-2 rounded-full transition-all duration-1000" style="width: @ProgressPercent%"></div>
                        </div>
                        <span class="font-label-sm text-sm text-primary font-bold">@ProgressPercent%</span>
                    </div>
                </div>
                
                <!-- Timelines -->
                <div class="bg-surface-white rounded-2xl border border-border-subtle shadow-sm p-6 flex-1 flex flex-col">
                    <h3 class="font-label-md text-xs text-on-surface-variant uppercase tracking-wider mb-6 font-bold">Unit Timeline Activity</h3>
                    @if (RecentActivity.Count == 0)
                    {
                        <p class="text-on-surface-variant text-center py-6 text-sm">No recent transactions tracked.</p>
                    }
                    else
                    {
                        <div class="relative border-l-2 border-surface-container-high ml-3 flex-1 flex flex-col justify-around gap-4 pl-4">
                            @foreach (var item in RecentActivity)
                            {
                                <div class="relative pl-2">
                                    <span class="absolute -left-[23px] top-1 h-3 w-3 rounded-full bg-primary ring-4 ring-surface-white"></span>
                                    <p class="font-bold text-xs text-on-surface">@item.Message</p>
                                    <p class="text-[10px] text-on-surface-variant mt-0.5">@item.At.ToString("MMM d, h:mm tt")</p>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    }
    else if (CurrentState == DashboardState.Rejected)
    {
        <div class="flex flex-col gap-6">
            <div class="bg-danger-bg/40 rounded-2xl p-5 border border-danger/20 flex gap-4">
                <span class="material-symbols-outlined text-danger text-3xl animate-pulse-glow">warning</span>
                <div>
                    <h4 class="font-bold text-sm text-on-error-container">Report Returned for Correction</h4>
                    <p class="text-xs text-on-surface-variant mt-1">Review feedback notes below and modify the flagged department sections.</p>
                    <div class="mt-3 p-3 bg-surface-white border border-danger/10 rounded-xl text-xs font-semibold text-on-surface italic shadow-sm">
                        "@(CurrentReport?.PresidentialNotes ?? "Please review and correct discrepancies.")"
                    </div>
                </div>
            </div>
            
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
                <!-- Bento Cards (8 cols) -->
                <div class="lg:col-span-8 flex flex-col gap-6">
                    <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-6">
                        @foreach (var dept in AllowedDepartments)
                        {
                            var isSubmitted = CurrentReport?.DepartmentReports.Any(d => d.Department == dept && d.IsSubmitted) ?? false;
                            var icon = GetDepartmentIcon(dept);
                            var iconBgClass = isSubmitted ? "bg-success-bg text-success" : "bg-warning-bg text-warning";
                            
                            <div class="bg-bg-cream rounded-2xl border border-border-subtle p-5 shadow-sm hover:-translate-y-1 hover:shadow-[0_8px_30px_0_rgba(197,168,128,0.25)] hover:bg-surface-white transition-all duration-300 flex flex-col group cursor-pointer" @onclick="() => EditDepartment(dept)">
                                <div class="flex flex-col items-start mb-4">
                                    <div class="w-10 h-10 rounded-full @iconBgClass flex items-center justify-center mb-3">
                                        <span class="material-symbols-outlined fill text-lg">@icon</span>
                                    </div>
                                    <h3 class="font-bold text-sm text-on-surface">@GetDepartmentTitle(dept)</h3>
                                </div>
                                <p class="font-body-sm text-body-sm text-on-surface-variant line-clamp-2 mb-6 flex-1">@GetDepartmentHint(dept)</p>
                                <div class="flex items-center justify-between mt-auto">
                                    <button class="py-1.5 px-3 rounded-lg bg-surface-white border border-danger/30 text-danger font-semibold text-xs hover:bg-danger hover:text-on-error hover:border-danger transition-all">
                                        Revise
                                    </button>
                                    <span class="px-2.5 py-0.5 rounded-full text-[10px] font-bold uppercase tracking-wider @(isSubmitted ? "bg-success-bg text-success" : "bg-warning-bg text-warning") border border-transparent">
                                        @(isSubmitted ? "Submitted" : "Needs Review")
                                    </span>
                                </div>
                            </div>
                        }
                    </div>

                    @if (CanSubmitFullReport)
                    {
                        <button class="py-3 px-6 rounded-xl bg-success hover:bg-primary text-white font-semibold text-sm flex items-center justify-center gap-2 hover:shadow-lg transition-all cursor-pointer w-full mt-4 border-0" @onclick="OpenSubmitReportModal" disabled="@(SubmittedDepartments < TotalDepartments || IsLoading)">
                            <span class="material-symbols-outlined">check_circle</span>
                            <span>Resubmit Core Report Container</span>
                        </button>
                    }
                </div>
                
                <!-- Side panels (4 cols) -->
                <div class="lg:col-span-4 bg-surface-white rounded-2xl border border-border-subtle shadow-sm p-6 flex flex-col">
                    <h5 class="font-bold text-sm text-on-surface mb-3 border-b border-border-subtle pb-1">Correction Action Rules</h5>
                    <ol class="text-xs text-on-surface-variant space-y-3 list-decimal pl-4">
                        <li>Read the red president alert notes above.</li>
                        <li>Click "Revise" on department cards to open forms.</li>
                        <li>Update fields and re-click "Submit Department" to save.</li>
                        <li>Resubmit the compiled report to the reviewer.</li>
                    </ol>
                </div>
            </div>
        </div>
    }
    else if (CurrentState == DashboardState.SubmittedToPresident)
    {
        <div class="bg-surface-white border border-border-subtle rounded-2xl p-6 shadow-sm flex flex-col md:flex-row items-center gap-6 justify-between">
            <div class="flex gap-4 items-center">
                <span class="material-symbols-outlined text-5xl text-primary animate-pulse-glow">hourglass_empty</span>
                <div>
                    <h4 class="font-headline-sm text-lg text-primary font-bold">Report Submitted Successfully</h4>
                    <p class="text-sm text-on-surface-variant mt-1">Awaiting Unit President audit. Submitted at: <strong>@CurrentReport?.SubmittedToPresidentAt?.ToString("MMM d, yyyy - h:mm tt")</strong></p>
                </div>
            </div>
            
            <div class="bg-bg-cream px-5 py-3 rounded-xl border border-border-subtle text-xs text-on-surface-variant font-semibold shadow-inner flex items-center gap-2">
                <span class="material-symbols-outlined text-sm">lock</span>
                <span>Workspace locked during leadership audit reviews</span>
            </div>
        </div>
    }
    else if (CurrentState == DashboardState.Acknowledged)
    {
        <div class="bg-surface-white border border-border-subtle rounded-2xl p-6 shadow-sm">
            <div class="bg-success-bg border border-success/25 rounded-2xl p-4 flex gap-4 items-center mb-6">
                <span class="material-symbols-outlined text-4xl text-success animate-pulse-glow">verified</span>
                <div>
                    <h4 class="font-bold text-sm text-success">Report Acknowledged by National Secretariat</h4>
                    <p class="text-xs text-on-surface-variant mt-0.5">Jazakumullah Khairan! The report cycle is closed, verified, and archived successfully.</p>
                </div>
            </div>
            
            <div class="flex flex-col sm:flex-row justify-around items-center gap-4 bg-bg-cream p-4 rounded-xl border border-border-subtle">
                <div class="flex items-center gap-2 text-success font-bold text-xs">
                    <span class="material-symbols-outlined text-sm">task_alt</span>
                    <span>1. Unit Approved</span>
                </div>
                <div class="h-0.5 w-12 bg-success hidden sm:block"></div>
                <div class="flex items-center gap-2 text-success font-bold text-xs">
                    <span class="material-symbols-outlined text-sm">task_alt</span>
                    <span>2. State Collated</span>
                </div>
                <div class="h-0.5 w-12 bg-success hidden sm:block"></div>
                <div class="flex items-center gap-2 text-success font-bold text-xs">
                    <span class="material-symbols-outlined text-sm">task_alt</span>
                    <span>3. National Locked</span>
                </div>
            </div>
        </div>
    }

    <!-- History & Read-Only Sections -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 mt-4">
        <!-- History Selector (4 cols) -->
        <div class="lg:col-span-4 bg-surface-white rounded-2xl border border-border-subtle shadow-sm flex flex-col">
            <div class="p-5 border-b border-border-subtle flex justify-between items-center bg-surface-container-lowest rounded-t-2xl">
                <h4 class="font-headline-sm text-base text-on-surface font-bold flex items-center gap-2">
                    <span class="material-symbols-outlined text-primary">history</span>
                    <span>Report History</span>
                </h4>
                <button class="px-3 py-1 text-xs bg-primary-light hover:bg-secondary-container text-primary font-semibold rounded-lg border border-border-subtle transition-colors cursor-pointer" @onclick="ReloadReportHistoryAsync" disabled="@IsRetrievalLoading">
                    Refresh
                </button>
            </div>
            
            <div class="p-4 flex flex-col gap-3 overflow-y-auto max-h-[460px]">
                @if (IsRetrievalLoading)
                {
                    <div class="text-center text-on-surface-variant py-8 flex flex-col items-center gap-2">
                        <span class="material-symbols-outlined text-3xl text-primary animate-spin">sync</span>
                        <span class="text-sm">Loading historical archives...</span>
                    </div>
                }
                else if (ReportHistory.Count == 0)
                {
                    <p class="text-on-surface-variant text-center py-8 text-sm">No reports archived in the system database.</p>
                }
                else
                {
                    @foreach (var report in ReportHistory)
                    {
                        var isSelected = SelectedReport?.ReportId == report.ReportId;
                        var selectClass = isSelected ? "border-primary bg-primary-light/40" : "border-border-subtle hover:border-accent-gold hover:bg-bg-cream";
                        
                        <div class="border rounded-xl p-4 transition-all duration-300 flex items-center justify-between gap-3 @selectClass">
                            <div class="flex items-center gap-3">
                                <span class="material-symbols-outlined text-2xl text-primary">assignment</span>
                                <div>
                                    <h6 class="font-bold text-sm text-on-surface mb-0.5">@report.CycleLabel</h6>
                                    <div class="flex items-center gap-1.5 flex-wrap">
                                        <span class="px-2 py-0.5 rounded-full text-[10px] font-bold uppercase tracking-wider bg-surface-variant text-on-surface-variant">@report.Status</span>
                                        <span class="text-[11px] text-on-surface-variant">@report.SubmittedDepartments/@report.TotalDepartments done</span>
                                    </div>
                                </div>
                            </div>
                            <button class="py-1 px-3 rounded-lg bg-surface-white border border-border-subtle text-primary font-label-sm text-[12px] hover:bg-primary hover:text-on-primary hover:border-primary transition-colors cursor-pointer flex items-center gap-1 border-0" @onclick="() => ViewReportAsync(report.ReportId)">
                                <span class="material-symbols-outlined text-sm">visibility</span>
                                <span>View</span>
                            </button>
                        </div>
                    }
                }
            </div>
        </div>

        <!-- Read Only View (8 cols) -->
        <div class="lg:col-span-8 bg-surface-white rounded-2xl border border-border-subtle shadow-sm p-6">
            <div class="flex justify-between items-center border-b border-border-subtle pb-3 mb-4">
                <h4 class="font-headline-sm text-base text-on-surface font-bold flex items-center gap-2">
                    <span class="material-symbols-outlined text-primary">folder_open</span>
                    <span>Archived Data Viewer</span>
                </h4>
                @if (SelectedReport is not null)
                {
                    <span class="px-3 py-1 rounded-full text-xs font-semibold bg-primary-light border border-primary/20 text-primary">@SelectedReport.CycleLabel</span>
                }
            </div>

            @if (IsSelectedReportLoading)
            {
                <div class="text-center text-on-surface-variant py-12 flex flex-col items-center gap-2">
                    <span class="material-symbols-outlined text-4xl text-primary animate-spin">sync</span>
                    <span class="text-sm font-semibold">Loading archived dataset...</span>
                </div>
            }
            else if (SelectedReport is null)
            {
                <div class="flex flex-col items-center justify-center text-center py-16 text-outline">
                    <span class="material-symbols-outlined text-6xl text-border-subtle mb-3">folder</span>
                    <h5 class="font-bold text-on-surface text-lg mb-1">Select a Report</h5>
                    <p class="text-sm text-on-surface-variant max-w-sm">Choose a historical report from the left timeline to review submitted metrics, feedback logs, and activity audits.</p>
                </div>
            }
            else
            {
                <div class="flex flex-wrap gap-2 mb-4">
                    <span class="px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-surface-variant text-on-surface-variant">@SelectedReport.Status</span>
                    <span class="px-3 py-1 rounded-full text-xs font-semibold bg-bg-cream text-on-surface-variant">Created: @SelectedReport.CreatedAt.ToString("MMM d, yyyy")</span>
                    @if (SelectedReport.SubmittedAt.HasValue)
                    {
                        <span class="px-3 py-1 rounded-full text-xs font-semibold bg-success-bg text-success border border-success/15">Submitted: @SelectedReport.SubmittedAt.Value.ToString("MMM d, yyyy")</span>
                    }
                </div>

                @if (SelectedReportDetails is not null)
                {
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-6">
                        <div class="bg-bg-cream p-4 rounded-xl border border-border-subtle flex items-center gap-4 shadow-sm">
                            <span class="material-symbols-outlined text-3xl text-primary bg-surface-white p-2 rounded-lg">grid_view</span>
                            <div>
                                <p class="text-[10px] text-on-surface-variant uppercase tracking-wider font-semibold">Total Sections</p>
                                <h4 class="font-bold text-2xl text-primary mt-0.5">@SelectedReportDetails.Departments.Count</h4>
                                <p class="text-xs text-on-surface-variant">@SelectedReportDetails.Departments.Count(d => d.IsSubmitted) submitted to system</p>
                            </div>
                        </div>
                        <div class="bg-bg-cream p-4 rounded-xl border border-border-subtle flex items-center gap-4 shadow-sm">
                            <span class="material-symbols-outlined text-3xl text-primary bg-surface-white p-2 rounded-lg">assignment_ind</span>
                            <div>
                                <p class="text-[10px] text-on-surface-variant uppercase tracking-wider font-semibold">Workflow Actions</p>
                                <h4 class="font-bold text-2xl text-primary mt-0.5">@SelectedReportDetails.ActivityLogs.Count</h4>
                                <p class="text-xs text-on-surface-variant">Audit operations recorded</p>
                            </div>
                        </div>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <!-- Dept lists -->
                        <div>
                            <h5 class="font-bold text-sm text-on-surface mb-3 border-b border-border-subtle pb-1">Department Summary</h5>
                            <div class="flex flex-col gap-2 max-h-[220px] overflow-y-auto">
                                @foreach (var department in SelectedReportDetails.Departments)
                                {
                                    <div class="flex justify-between items-center border-b border-border-subtle py-2">
                                        <span class="text-sm font-medium text-on-surface-variant">@department.DepartmentName</span>
                                        <span class="px-2.5 py-0.5 rounded-full text-[10px] font-bold uppercase tracking-wider @(department.IsSubmitted ? "bg-success-bg text-success border border-success/15" : "bg-warning-bg text-warning border border-warning/15") border">
                                            @(department.IsSubmitted ? "Submitted" : "Draft")
                                        </span>
                                    </div>
                                }
                            </div>
                        </div>
                        
                        <!-- Timeline -->
                        <div>
                            <h5 class="font-bold text-sm text-on-surface mb-3 border-b border-border-subtle pb-1">Audit Log</h5>
                            <div class="flex flex-col gap-3 overflow-y-auto max-h-[220px] ml-2 border-l-2 border-surface-container-high pl-4">
                                @foreach (var activity in SelectedReportDetails.ActivityLogs)
                                {
                                    <div class="relative mb-2">
                                        <span class="absolute -left-[21px] top-1.5 h-2 w-2 rounded-full bg-primary ring-4 ring-surface-white"></span>
                                        <div class="text-[11px] font-bold text-outline uppercase tracking-wider">@activity.At.ToString("MMM d, h:mm tt")</div>
                                        <p class="text-xs font-semibold text-on-surface mt-0.5">@ToReadableActivity(activity.Action)</p>
                                        @if (!string.IsNullOrWhiteSpace(activity.Notes))
                                        {
                                            <p class="text-[11px] text-on-surface-variant bg-bg-cream px-2 py-1 rounded mt-1 border border-border-subtle">@activity.Notes</p>
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                }
            }
        </div>
    </div>
</div>

<!-- Create Report Modal -->
@if (IsCreateReportModalOpen)
{
    <div class="fixed inset-0 bg-primary-deep/40 backdrop-blur-sm z-50 flex items-center justify-center p-4">
        <div class="bg-surface-white rounded-2xl max-w-md w-full shadow-2xl border border-border-subtle overflow-hidden animate-slideIn">
            <div class="p-6 bg-gradient-to-r from-primary to-primary-container text-white flex justify-between items-center">
                <h5 class="font-headline-sm text-lg font-bold flex items-center gap-2 mb-0">
                    <span class="material-symbols-outlined">add_circle</span>
                    <span>Create New Report</span>
                </h5>
                <button type="button" class="text-white/80 hover:text-white bg-transparent border-0 cursor-pointer" @onclick="CloseCreateReportModal">
                    <span class="material-symbols-outlined">close</span>
                </button>
            </div>
            <div class="p-6 flex flex-col gap-4">
                <p class="text-sm text-on-surface-variant">You're about to initialize the monthly combined report cycle for <strong>@CycleLabel</strong>.</p>
                <div class="bg-primary-light p-4 rounded-xl border border-primary/10 flex gap-3 items-start">
                    <span class="material-symbols-outlined text-primary text-2xl">info</span>
                    <p class="text-xs text-on-primary-fixed-variant leading-relaxed">
                        Initializing this report will enable all assigned department officers to begin entry. You can save changes as draft anytime.
                    </p>
                </div>
                <div class="bg-warning-bg/40 p-4 rounded-xl border border-warning/10 text-sm font-semibold text-warning flex justify-between items-center">
                    <span>Active Cycle Deadline:</span>
                    <span class="px-2.5 py-0.5 bg-surface-white border border-warning/20 rounded shadow-sm">@DeadlineLabel</span>
                </div>
            </div>
            <div class="p-4 bg-bg-cream border-t border-border-subtle flex justify-end gap-3">
                <button type="button" class="px-4 py-2 bg-surface-white border border-border-subtle text-on-surface rounded-lg font-semibold text-sm hover:bg-surface-container-low transition-colors cursor-pointer" @onclick="CloseCreateReportModal">Cancel</button>
                <button type="button" class="px-5 py-2 bg-primary hover:bg-primary-container text-white rounded-lg font-semibold text-sm transition-all shadow-md flex items-center gap-2 cursor-pointer border-0" @onclick="OnCreateReportConfirmedAsync" disabled="@IsLoading">
                    @if (IsLoading)
                    {
                        <span class="material-symbols-outlined text-sm animate-spin">sync</span>
                        <span>Creating...</span>
                    }
                    else
                    {
                        <span class="material-symbols-outlined text-sm">check_circle</span>
                        <span>Create Report</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

<!-- Submit Report Modal -->
@if (IsSubmitReportModalOpen)
{
    <div class="fixed inset-0 bg-primary-deep/40 backdrop-blur-sm z-50 flex items-center justify-center p-4">
        <div class="bg-surface-white rounded-2xl max-w-lg w-full shadow-2xl border border-border-subtle overflow-hidden animate-slideIn">
            <div class="p-6 bg-gradient-to-r from-success to-primary-container text-white flex justify-between items-center">
                <h5 class="font-headline-sm text-lg font-bold flex items-center gap-2 mb-0">
                    <span class="material-symbols-outlined">send</span>
                    <span>Submit Report for Review</span>
                </h5>
                <button type="button" class="text-white/80 hover:text-white bg-transparent border-0 cursor-pointer" @onclick="CloseSubmitReportModal">
                    <span class="material-symbols-outlined">close</span>
                </button>
            </div>
            <div class="p-6 flex flex-col gap-4">
                <p class="text-sm text-on-surface-variant">You are preparing to submit the Ibadan Central Unit's monthly report to the Unit President for formal review.</p>
                <div class="bg-warning-bg/40 p-4 rounded-xl border border-warning/10 flex gap-3">
                    <span class="material-symbols-outlined text-warning text-2xl">warning</span>
                    <div>
                        <h6 class="font-bold text-xs text-warning uppercase tracking-wider mb-1">Important Checklist</h6>
                        <ul class="text-xs text-on-surface-variant space-y-1 list-disc pl-4">
                            <li>All 9 department sections are marked as submitted and locked.</li>
                            <li>Section-level modifications will be frozen during leadership review.</li>
                            <li>Unit President will either acknowledge the report or return it with comments.</li>
                        </ul>
                    </div>
                </div>
                
                <div class="flex flex-col gap-1.5">
                    <label for="submissionNotes" class="text-xs font-bold text-outline uppercase tracking-wider">Submission Notes (Optional)</label>
                    <textarea class="w-full rounded-xl border border-border-subtle p-3 text-sm focus:border-accent-gold focus:ring-4 focus:ring-gold-glow outline-none transition-all" id="submissionNotes" rows="3" @bind="SubmissionNotes" placeholder="Write any notes or operational highlights for the President..."></textarea>
                </div>
            </div>
            <div class="p-4 bg-bg-cream border-t border-border-subtle flex justify-end gap-3">
                <button type="button" class="px-4 py-2 bg-surface-white border border-border-subtle text-on-surface rounded-lg font-semibold text-sm hover:bg-surface-container-low transition-colors cursor-pointer" @onclick="CloseSubmitReportModal">Cancel</button>
                <button type="button" class="px-5 py-2 bg-success hover:bg-primary text-white rounded-lg font-semibold text-sm transition-all shadow-md flex items-center gap-2 cursor-pointer border-0" @onclick="OnSubmitReportAsync" disabled="@(IsLoading || SubmittedDepartments < TotalDepartments)">
                    @if (IsLoading)
                    {
                        <span class="material-symbols-outlined text-sm animate-spin">sync</span>
                        <span>Submitting...</span>
                    }
                    else
                    {
                        <span class="material-symbols-outlined text-sm">verified</span>
                        <span>Submit Report</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

@code {
    private record ActivityItem(DateTime At, string Message);

    [Parameter]
    public AuthContext? CurrentUser { get; set; }

    private List<DepartmentType> AllowedDepartments { get; set; } = new();
    private string CycleLabel { get; set; } = "-";
    private string DeadlineLabel { get; set; } = "-";
    private int? DaysLeft { get; set; }
    private int TotalDepartments { get; set; }
    private int SubmittedDepartments { get; set; }
    private Report? CurrentReport { get; set; }
    private ReportingCycle? CurrentCycle { get; set; }
    private List<ActivityItem> RecentActivity { get; set; } = new();
    private List<ReportRetrievalSummary> ReportHistory { get; set; } = new();
    private ReportRetrievalSummary? SelectedReport { get; set; }
    private ReportRetrievalDetails? SelectedReportDetails { get; set; }
    private bool IsLoading { get; set; }
    private bool IsRetrievalLoading { get; set; }
    private bool IsSelectedReportLoading { get; set; }
    private string? ErrorMessage { get; set; }
    private string? SuccessMessage { get; set; }
    private string? SubmissionNotes { get; set; }
    private bool IsCreateReportModalOpen { get; set; }
    private bool IsSubmitReportModalOpen { get; set; }

    private enum DashboardState { NoReportExists, DraftExists, SubmittedToPresident, Rejected, Acknowledged }
    private DashboardState CurrentState { get; set; } = DashboardState.NoReportExists;

    private int ProgressPercent => TotalDepartments == 0 ? 0 : (int)Math.Round((SubmittedDepartments * 100.0) / TotalDepartments);
    private bool CanSubmitFullReport =>
        CurrentUser is not null &&
        (CurrentUser.IsUnitLeadership || CurrentUser.IsStateLeadership || CurrentUser.IsNationalLeadership || CurrentUser.HasSudoAccess);

    protected override async Task OnInitializedAsync()
    {
        AllowedDepartments = GetAllowedDepartments();
        await LoadSummaryAsync();
        await ReloadReportHistoryAsync();
    }

    private async Task LoadSummaryAsync()
    {
        if (CurrentUser is null || !CurrentUser.IsAuthenticated)
            return;

        IsLoading = true;
        ErrorMessage = null;

        try
        {
            CurrentCycle = await ReportingApiClient.GetActiveCycleAsync();
            CycleLabel = CurrentCycle.CycleMonth;
            DeadlineLabel = CurrentCycle.SubmissionDeadline.ToString("MMMM d, yyyy");
            DaysLeft = (CurrentCycle.SubmissionDeadline.Date - DateTime.UtcNow.Date).Days;

            CurrentReport = await ReportingApiClient.GetCurrentDraftAsync(CurrentCycle.Id);

            if (CurrentReport is null)
            {
                CurrentState = DashboardState.NoReportExists;
            }
            else
            {
                CurrentState = CurrentReport.Status switch
                {
                    ReportStatus.Draft => DashboardState.DraftExists,
                    ReportStatus.SubmittedToPresident or ReportStatus.SubmittedToState or ReportStatus.SubmittedToNational => DashboardState.SubmittedToPresident,
                    ReportStatus.RejectedByPresident or ReportStatus.RejectedByState => DashboardState.Rejected,
                    ReportStatus.Acknowledged => DashboardState.Acknowledged,
                    _ => DashboardState.NoReportExists
                };

                if (CurrentState == DashboardState.DraftExists || CurrentState == DashboardState.Rejected)
                {
                    TotalDepartments = CurrentReport.DepartmentReports.Count == 0 ? 9 : CurrentReport.DepartmentReports.Count;
                    SubmittedDepartments = CurrentReport.DepartmentReports.Count(d => d.IsSubmitted);
                    RecentActivity = CurrentReport.ActivityLogs
                        .OrderByDescending(log => log.ActionAt)
                        .Take(6)
                        .Select(log => new ActivityItem(log.ActionAt, ToReadableActivity(log.Action)))
                        .ToList();
                }
            }
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Error loading dashboard: {ex.Message}";
        }
        finally
        {
            IsLoading = false;
        }
    }

    private async Task ReloadReportHistoryAsync()
    {
        if (CurrentUser is null || !CurrentUser.IsAuthenticated)
            return;

        IsRetrievalLoading = true;

        try
        {
            ReportHistory = (await ReportingApiClient.GetReportHistoryAsync()).ToList();
            if (SelectedReport is not null && ReportHistory.All(report => report.ReportId != SelectedReport.ReportId))
            {
                SelectedReport = null;
                SelectedReportDetails = null;
            }
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Error loading report history: {ex.Message}";
        }
        finally
        {
            IsRetrievalLoading = false;
        }
    }

    private async Task ViewReportAsync(int reportId)
    {
        IsSelectedReportLoading = true;
        SelectedReport = ReportHistory.FirstOrDefault(report => report.ReportId == reportId);
        SelectedReportDetails = null;

        try
        {
            SelectedReportDetails = await ReportingApiClient.GetReportDetailsAsync(reportId);
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Error loading report details: {ex.Message}";
        }
        finally
        {
            IsSelectedReportLoading = false;
        }
    }

    private async Task OnCreateReportConfirmedAsync()
    {
        if (CurrentCycle is null || CurrentUser is null)
            return;

        IsLoading = true;
        ErrorMessage = null;

        try
        {
            CurrentReport = await ReportingApiClient.CreateDraftAsync(CurrentCycle.Id);
            CurrentState = DashboardState.DraftExists;
            TotalDepartments = CurrentReport.DepartmentReports.Count == 0 ? 9 : CurrentReport.DepartmentReports.Count;
            SubmittedDepartments = 0;
            RecentActivity.Clear();
            SuccessMessage = $"Report created for {CycleLabel}. Start filling out your department sections!";
            CloseCreateReportModal();
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Error creating report: {ex.Message}";
        }
        finally
        {
            IsLoading = false;
        }
    }

    private async Task OnSubmitReportAsync()
    {
        if (CurrentReport is null || !CanSubmitFullReport || SubmittedDepartments < TotalDepartments)
            return;

        IsLoading = true;
        ErrorMessage = null;

        try
        {
            CurrentReport = await ReportingApiClient.SubmitReportAsync(CurrentReport.Id, SubmissionNotes);
            CurrentState = DashboardState.SubmittedToPresident;
            SuccessMessage = "Report submitted successfully to your unit president for review.";
            SubmissionNotes = null;
            CloseSubmitReportModal();
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Error submitting report: {ex.Message}";
        }
        finally
        {
            IsLoading = false;
        }
    }

    private void EditDepartment(DepartmentType department)
    {
        Nav.NavigateTo($"/report/{department.ToString().ToLowerInvariant()}");
    }

    private void OpenCreateReportModal() => IsCreateReportModalOpen = true;
    private void CloseCreateReportModal() => IsCreateReportModalOpen = false;
    private void OpenSubmitReportModal() => IsSubmitReportModalOpen = true;
    private void CloseSubmitReportModal() => IsSubmitReportModalOpen = false;

    private void CloseErrorMessage() => ErrorMessage = null;
    private void CloseSuccessMessage() => SuccessMessage = null;

    private static string GetReportStatusBadgeClass(ReportStatus status) => status switch
    {
        ReportStatus.Draft => "draft",
        ReportStatus.SubmittedToPresident or ReportStatus.SubmittedToState or ReportStatus.SubmittedToNational => "submitted",
        ReportStatus.RejectedByPresident or ReportStatus.RejectedByState => "draft",
        ReportStatus.Acknowledged => "submitted",
        _ => "draft"
    };

    private List<DepartmentType> GetAllowedDepartments()
    {
        if (CurrentUser is null || !CurrentUser.IsAuthenticated)
            return new();

        var allowed = new List<DepartmentType>();
        foreach (var department in ReportDepartmentCatalog.ReportableDepartments)
        {
            if (ReportAccessService.CanEditDepartment(CurrentUser, CurrentUser.UnitId, CurrentUser.StateId, department))
                allowed.Add(department);
        }
        return allowed;
    }

    private static string GetDepartmentTitle(DepartmentType department) => department switch
    {
        DepartmentType.Taleem => "Ta'leem (Education)",
        DepartmentType.Tabligh => "Tabligh (Outreach)",
        DepartmentType.Welfare => "Welfare (Amoomi)",
        DepartmentType.Sport => "Sport & Physical",
        DepartmentType.Finance => "Finance (Maal)",
        DepartmentType.Health => "Health & Medical",
        DepartmentType.SecondarySchool => "Secondary School",
        DepartmentType.Tajneed => "Tajneed (Census)",
        DepartmentType.General => "General & Challenges",
        _ => department.ToString()
    };

    private static string GetDepartmentHint(DepartmentType department) => department switch
    {
        DepartmentType.Taleem => "Report on study circles, syllabus completion, and monthly Quranic test turnout.",
        DepartmentType.Tabligh => "Report outreach programs, public lectures, literature distributions, and campus activities.",
        DepartmentType.Welfare => "Report local financial support programs, social aid runs, and check-ins for active members.",
        DepartmentType.Sport => "Record sports sessions, games played, physical meets, and total member participants.",
        DepartmentType.Finance => "Track monthly membership dues, expected target collections, and audit logs.",
        DepartmentType.Health => "Log local medical runs, health education seminars, first aid setups, and beneficiaries.",
        DepartmentType.SecondarySchool => "Track educational tutorials, secondary school student support, and JAMB prep.",
        DepartmentType.Tajneed => "Input total member logs, updates to registry sheets, and census data audits.",
        DepartmentType.General => "Report operational issues, unit resolutions, and other miscellaneous activities.",
        _ => "Report department activities"
    };

    private string GetDepartmentStatusBadgeClass(DepartmentType department)
    {
        if (CurrentReport is null) return "draft";
        var dept = CurrentReport.DepartmentReports.FirstOrDefault(d => d.Department == department);
        return dept?.IsSubmitted == true ? "submitted" : "draft";
    }

    private string GetDepartmentStatusLabel(DepartmentType department)
    {
        if (CurrentReport is null) return "Not Started";
        var dept = CurrentReport.DepartmentReports.FirstOrDefault(d => d.Department == department);
        return dept?.IsSubmitted == true ? "Submitted" : "Not Submitted";
    }

    private string GetDepartmentIcon(DepartmentType department) => department switch
    {
        DepartmentType.Taleem => "menu_book",
        DepartmentType.Tabligh => "campaign",
        DepartmentType.Welfare => "favorite",
        DepartmentType.Sport => "sports_soccer",
        DepartmentType.Finance => "account_balance_wallet",
        DepartmentType.Health => "medical_services",
        DepartmentType.SecondarySchool => "school",
        DepartmentType.Tajneed => "group",
        DepartmentType.General => "description",
        _ => "list"
    };

    private static string ToReadableActivity(string action) => action switch
    {
        "ReportCreated" => "Report created",
        "ReportSubmittedToPresident" => "Report submitted to unit president",
        "ApprovedByUnitLeadership" => "Approved by unit leadership",
        "RejectedByUnitLeadership" => "Rejected by unit leadership",
        "RejectedByStateLeadership" => "Rejected by state leadership",
        "ApprovedByStateLeadership" => "Approved by state leadership",
        "AcknowledgedByNational" => "Acknowledged by National GS",
        "DepartmentReportSubmitted" => "Department section submitted",
        "DepartmentReportSaved" => "Department section draft saved",
        _ => action
    };
}
