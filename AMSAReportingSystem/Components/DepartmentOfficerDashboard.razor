@using AMSAReportingSystem.Services
@using AMSAReportingSystem.Data.Entities
@inject NavigationManager Nav
@inject ReportAccessService ReportAccessService
@inject CurrentUserReportService CurrentUserReportService

<div class="container">
    <div class="row mb-4">
        <div class="col-md-12">
            <div class="card">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">Monthly Report Submission</h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6">
                            <div class="info-box">
                                <h6 class="text-muted">Reporting Cycle</h6>
                                <p class="mb-0"><strong>@CycleLabel</strong></p>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="info-box">
                                <h6 class="text-muted">Submission Deadline</h6>
                                <p class="mb-0">
                                    <strong>@DeadlineLabel</strong>
                                    @if (DaysLeft is not null)
                                    {
                                        <span class="badge @(DaysLeft <= 3 ? "bg-warning" : "bg-success")">@DaysLeft day(s) left</span>
                                    }
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-8">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">Your Department Section</h5>
                </div>
                <div class="card-body">
                    @if (AllowedDepartments.Count == 0)
                    {
                        <div class="alert alert-warning mb-0">
                            No departments are available for your account right now.
                        </div>
                    }
                    else
                    {
                        <div class="section-selector">
                            @foreach (var dept in AllowedDepartments)
                            {
                                <div class="section-card">
                                    <div class="section-icon">
                                        <i class="bi @GetDepartmentIcon(dept)"></i>
                                    </div>
                                    <div class="section-info">
                                        <h6>@GetDepartmentTitle(dept)</h6>
                                        <p class="mb-2 text-muted">@GetDepartmentHint(dept)</p>
                                        <small class="status-badge @GetDepartmentStatusBadgeClass(dept)">@GetDepartmentStatusLabel(dept)</small>
                                    </div>
                                    <button class="btn btn-primary btn-sm" @onclick="() => EditDepartment(dept)">
                                        Edit Form →
                                    </button>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card mb-3">
                <div class="card-header bg-light">
                    <h6 class="mb-0">Progress</h6>
                </div>
                <div class="card-body">
                    <div class="progress mb-3">
                        <div class="progress-bar" role="progressbar" style="width: @ProgressPercent%;" aria-valuenow="@ProgressPercent" aria-valuemin="0" aria-valuemax="100">@ProgressPercent%</div>
                    </div>
                    <small class="text-muted">@SubmittedDepartments of @TotalDepartments sections submitted</small>
                </div>
            </div>

            <div class="card">
                <div class="card-header bg-light">
                    <h6 class="mb-0">Recent Notifications</h6>
                </div>
                <div class="card-body" style="max-height: 300px; overflow-y: auto;">
                    @if (RecentActivity.Count == 0)
                    {
                        <p class="text-muted mb-0">No recent activity yet for this cycle.</p>
                    }
                    else
                    {
                        @foreach (var item in RecentActivity)
                        {
                            <div class="notification-item">
                                <small class="text-muted d-block mb-1">@item.At.ToString("MMM d, yyyy h:mm tt")</small>
                                <p class="mb-2">@item.Message</p>
                            </div>
                            <hr class="my-2" />
                        }
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .info-box {
        padding: 15px;
        background: #f8f9fa;
        border-radius: 6px;
    }

    .section-selector {
        display: flex;
        flex-direction: column;
        gap: 15px;
    }

    .section-card {
        display: flex;
        align-items: center;
        gap: 15px;
        padding: 20px;
        border: 2px solid #e9ecef;
        border-radius: 8px;
        background: white;
        transition: all 0.3s ease;
    }

    .section-card:hover {
        border-color: #667eea;
        box-shadow: 0 4px 12px rgba(102, 126, 234, 0.1);
    }

    .section-icon {
        font-size: 32px;
        color: #667eea;
        flex-shrink: 0;
    }

    .section-info {
        flex: 1;
    }

    .section-info h6 {
        margin: 0 0 4px 0;
        font-weight: 600;
    }

    .status-badge {
        display: inline-block;
        padding: 4px 8px;
        border-radius: 4px;
        font-size: 12px;
        font-weight: 600;
    }

    .status-badge.draft {
        background: #fff3cd;
        color: #856404;
    }

    .status-badge.submitted {
        background: #d1ecf1;
        color: #0c5460;
    }

    .notification-item {
        padding: 10px 0;
    }

    .notification-item p {
        margin: 0;
        font-size: 14px;
    }
</style>

@code {
    [Parameter]
    public AuthContext? CurrentUser { get; set; }
    private List<DepartmentType> AllowedDepartments { get; set; } = new();
    private string CycleLabel { get; set; } = "Active Cycle";
    private string DeadlineLabel { get; set; } = "-";
    private int? DaysLeft { get; set; }
    private int TotalDepartments { get; set; } = 9;
    private int SubmittedDepartments { get; set; }
    private Report? CurrentReport { get; set; }
    private List<ActivityItem> RecentActivity { get; set; } = new();
    private int ProgressPercent => TotalDepartments == 0 ? 0 : (int)Math.Round((SubmittedDepartments * 100.0) / TotalDepartments);

    protected override async Task OnParametersSetAsync()
    {
        AllowedDepartments = GetAllowedDepartments();
        await LoadSummaryAsync();
    }

    private async Task LoadSummaryAsync()
    {
        if (CurrentUser is null || !CurrentUser.IsAuthenticated)
        {
            return;
        }

        try
        {
            var cycle = await CurrentUserReportService.EnsureActiveCycleAsync();
            CycleLabel = cycle.CycleMonth;
            DeadlineLabel = cycle.SubmissionDeadline.ToString("MMMM d, yyyy");
            DaysLeft = (cycle.SubmissionDeadline.Date - DateTime.UtcNow.Date).Days;

            CurrentReport = await CurrentUserReportService.EnsureCurrentUserDraftAsync(cycle.Id);
            TotalDepartments = CurrentReport.DepartmentReports.Count == 0 ? 9 : CurrentReport.DepartmentReports.Count;
            SubmittedDepartments = CurrentReport.DepartmentReports.Count(d => d.IsSubmitted);
            RecentActivity = CurrentReport.ActivityLogs
                .OrderByDescending(log => log.ActionAt)
                .Take(6)
                .Select(log => new ActivityItem(log.ActionAt, ToReadableActivity(log.Action)))
                .ToList();
        }
        catch
        {
            // Keep defaults on dashboard if data is unavailable.
        }
    }

    private void EditDepartment(DepartmentType department)
    {
        Nav.NavigateTo($"/report/{department.ToString().ToLowerInvariant()}");
    }

    private List<DepartmentType> GetAllowedDepartments()
    {
        if (CurrentUser is null || !CurrentUser.IsAuthenticated)
        {
            return new();
        }

        var allowed = new List<DepartmentType>();

        foreach (var department in ReportDepartmentCatalog.ReportableDepartments)
        {
            if (ReportAccessService.CanEditDepartment(CurrentUser, CurrentUser.UnitId, CurrentUser.StateId, department))
            {
                allowed.Add(department);
            }
        }

        return allowed;
    }

    private static string GetDepartmentTitle(DepartmentType department) => department switch
    {
        DepartmentType.Taleem => "Islamic Education (Taleem)",
        DepartmentType.Tabligh => "Preaching (Tabligh)",
        DepartmentType.Welfare => "Welfare",
        DepartmentType.Sport => "Sport",
        DepartmentType.Finance => "Finance",
        DepartmentType.Health => "Health",
        DepartmentType.SecondarySchool => "Secondary School",
        DepartmentType.Tajneed => "Tajneed",
        DepartmentType.General => "General",
        _ => department.ToString()
    };

    private static string GetDepartmentHint(DepartmentType department) => department switch
    {
        DepartmentType.Taleem => "Report on monthly education sessions and attendance",
        DepartmentType.Tabligh => "Report on preaching and outreach activities",
        DepartmentType.Welfare => "Report welfare and social service activities",
        DepartmentType.Sport => "Report sports and participation",
        DepartmentType.Finance => "Report collections and financial records",
        DepartmentType.Health => "Report health-related initiatives",
        DepartmentType.SecondarySchool => "Report secondary school outreach",
        DepartmentType.Tajneed => "Report member registry and follow-up",
        DepartmentType.General => "Report general activities and notes",
        _ => "Report department activities"
    };

    private static string GetDepartmentIcon(DepartmentType department) => department switch
    {
        DepartmentType.Taleem => "bi-book",
        DepartmentType.Tabligh => "bi-megaphone",
        DepartmentType.Welfare => "bi-heart",
        DepartmentType.Sport => "bi-trophy",
        DepartmentType.Finance => "bi-cash-stack",
        DepartmentType.Health => "bi-activity",
        DepartmentType.SecondarySchool => "bi-mortarboard",
        DepartmentType.Tajneed => "bi-people",
        DepartmentType.General => "bi-grid",
        _ => "bi-journal-text"
    };

    private string GetDepartmentStatusLabel(DepartmentType department)
    {
        var row = CurrentReport?.DepartmentReports.FirstOrDefault(d => d.Department == department);
        if (row is null)
        {
            return "Draft";
        }

        return row.IsSubmitted ? "Submitted" : "Draft";
    }

    private string GetDepartmentStatusBadgeClass(DepartmentType department)
    {
        var row = CurrentReport?.DepartmentReports.FirstOrDefault(d => d.Department == department);
        if (row?.IsSubmitted == true)
        {
            return "submitted";
        }

        return "draft";
    }

    private static string ToReadableActivity(string action)
    {
        if (action.StartsWith("DepartmentSaved:", StringComparison.OrdinalIgnoreCase))
        {
            return $"Saved {action["DepartmentSaved:".Length..]} report draft.";
        }

        if (action.StartsWith("DepartmentSubmitted:", StringComparison.OrdinalIgnoreCase))
        {
            return $"Submitted {action["DepartmentSubmitted:".Length..]} report section.";
        }

        return action switch
        {
            "ReportCreated" => "Your cycle report was created.",
            "ReportSubmittedToPresident" => "Full report submitted to unit leadership.",
            _ => action
        };
    }

    private sealed record ActivityItem(DateTime At, string Message);
}
