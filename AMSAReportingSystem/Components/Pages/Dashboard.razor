@page "/dashboard"
@using Microsoft.AspNetCore.Components.Authorization
@using AMSAReportingSystem.Services
@using AMSAReportingSystem.Data.Entities
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Nav
@rendermode @(new InteractiveServerRenderMode(prerender: false))

@if (CurrentUser == null)
{
    <div class="min-h-screen bg-bg-cream flex items-center justify-center p-6">
        <div class="bg-surface-white border border-border-subtle rounded-2xl p-8 max-w-sm w-full text-center shadow-lg animate-pulse flex flex-col items-center gap-4">
            <span class="material-symbols-outlined text-primary text-5xl animate-spin">sync</span>
            <span class="text-sm font-semibold text-primary">Loading user credentials...</span>
        </div>
    </div>
}
else
{
    @switch (DashboardKindValue)
    {
        case DashboardKind.NationalLeadership:
            <NationalLeadershipDashboard CurrentUser="@CurrentUser" />
            break;
        case DashboardKind.StateLeadership:
            <StateLeadershipDashboard CurrentUser="@CurrentUser" />
            break;
        case DashboardKind.UnitLeadership:
            <UnitLeadershipDashboard CurrentUser="@CurrentUser" />
            break;
        case DashboardKind.DepartmentOfficer:
            <DepartmentOfficerDashboard CurrentUser="@CurrentUser" />
            break;
        default:
            <div class="min-h-screen bg-bg-cream flex items-center justify-center p-6">
                <div class="bg-surface-white border border-border-subtle rounded-2xl p-8 max-w-md w-full text-center shadow-lg flex flex-col items-center gap-4">
                    <span class="material-symbols-outlined text-warning text-5xl">warning</span>
                    <div>
                        <h4 class="font-headline-sm text-lg text-warning font-bold">Role Configuration Needed</h4>
                        <p class="text-xs text-on-surface-variant mt-2">Your MKAN profile has not been assigned a workspace dashboard role. Please contact system administrators.</p>
                    </div>
                </div>
            </div>
            break;
    }
}

@code {
    private enum DashboardKind
    {
        Unknown,
        NationalLeadership,
        StateLeadership,
        UnitLeadership,
        DepartmentOfficer
    }

    private AuthContext? CurrentUser;
    private DashboardKind DashboardKindValue = DashboardKind.Unknown;

    protected override async Task OnInitializedAsync()
    {
        var amsaProvider = (AMSAAuthStateProvider)AuthStateProvider;
        CurrentUser = amsaProvider.GetCurrentUser();
        if (CurrentUser == null)
        {
            Nav.NavigateTo("/login", forceLoad: true);
            return;
        }

        DashboardKindValue = ResolveDashboardKind(CurrentUser);
    }

    private string GetRoleDescription() => DashboardKindValue switch
    {
        DashboardKind.NationalLeadership => "National Leadership",
        DashboardKind.StateLeadership => "State Leadership",
        DashboardKind.UnitLeadership => "Unit Leadership",
        DashboardKind.DepartmentOfficer => "Department Officer",
        _ => "User"
    };

    private static DashboardKind ResolveDashboardKind(AuthContext user)
    {
        if (user.IsNationalLeadership)
        {
            return DashboardKind.NationalLeadership;
        }

        if (user.IsStateLeadership)
        {
            return DashboardKind.StateLeadership;
        }

        if (user.IsUnitLeadership)
        {
            return DashboardKind.UnitLeadership;
        }

        return user.GetDashboard() == "UnitDashboard"
            ? DashboardKind.DepartmentOfficer
            : DashboardKind.Unknown;
    }
}
