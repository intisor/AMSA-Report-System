@page "/report/{DepartmentSlug}"
@using AMSAReportingSystem.Data.Entities
@using AMSAReportingSystem.Services
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Forms
@inject CurrentUserReportService CurrentUserReportService
@inject ReportingApiClient ReportingApiClient
@inject NavigationManager Nav
@rendermode @(new InteractiveServerRenderMode(prerender: false))

<PageTitle>@DepartmentName Department Report</PageTitle>

<div class="max-w-7xl mx-auto py-6 px-4 md:px-6 flex flex-col gap-6 animate-fadeIn pb-16">
    <!-- Header Controls -->
    <div class="flex justify-between items-center bg-surface-white border border-border-subtle p-4 rounded-2xl shadow-sm">
        <div class="flex items-center gap-3">
            <button class="flex items-center gap-1.5 px-3.5 py-1.5 bg-surface-white border border-border-subtle hover:bg-surface-container-low text-on-surface font-semibold text-xs rounded-xl shadow-sm cursor-pointer transition-colors" @onclick="BackToDashboard">
                <span class="material-symbols-outlined text-sm">arrow_back</span>
                <span>Back</span>
            </button>
            <div>
                <h3 class="font-headline-sm text-base text-primary font-bold mb-0">@DepartmentName Form</h3>
                <small class="text-xs text-on-surface-variant font-medium">@CycleLabel · Deadline: @DeadlineLabel</small>
            </div>
        </div>
        
        <div class="flex items-center gap-2">
            <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider @(DepartmentSubmitted ? "bg-success-bg text-success border border-success/15" : "bg-warning-bg text-warning border border-warning/15") border shadow-sm">
                <span class="material-symbols-outlined text-[14px] mr-1">@(DepartmentSubmitted ? "verified" : "sync")</span>
                @(DepartmentSubmitted ? "Submitted" : "Draft State")
            </span>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(Message))
    {
        <div class="p-4 rounded-xl border flex gap-3 items-center text-sm shadow-sm @(MessageClass == "alert-success" ? "bg-success-bg border-success/20 text-success" : "bg-danger-bg border-danger/20 text-danger")">
            <span class="material-symbols-outlined">@(MessageClass == "alert-success" ? "check_circle" : "error")</span>
            <span class="font-semibold">@Message</span>
        </div>
    }

    @if (IsLoading)
    {
        <div class="text-center text-on-surface-variant py-16 flex flex-col items-center gap-2 bg-surface-white rounded-2xl border border-border-subtle shadow-sm">
            <span class="material-symbols-outlined text-4xl text-primary animate-spin">sync</span>
            <span class="text-sm font-semibold">Loading report inputs...</span>
        </div>
    }
    else
    {
        @if (IsCycleLocked)
        {
            <div class="p-4 bg-warning-bg border border-warning/20 text-warning rounded-xl flex gap-3 text-sm font-semibold shadow-sm">
                <span class="material-symbols-outlined">lock</span>
                <span>This reporting cycle is locked. Form values are read-only.</span>
            </div>
        }

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
            <!-- Left Side: Data Entry Form Card (8 cols) -->
            <div class="lg:col-span-8 bg-surface-white rounded-2xl border border-border-subtle p-6 shadow-sm flex flex-col gap-5">
                <h4 class="font-headline-sm text-sm text-outline uppercase tracking-wider font-bold mb-2">Department Questionnaire</h4>
                
                @if (_department == DepartmentType.Taleem)
                {
                    <div class="flex flex-col gap-4">
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                            <div class="flex flex-col gap-1.5">
                                <label class="text-xs font-bold text-on-surface-variant">Ta'leem Session Attendees (Average)</label>
                                <input type="number" class="w-full rounded-xl border border-border-subtle p-3 text-sm focus:border-accent-gold focus:ring-4 focus:ring-gold-glow outline-none transition-all" min="0" @bind="Taleem.AttendanceCount" disabled="@IsCycleLocked" />
                            </div>
                            <div class="flex flex-col gap-1.5">
                                <label class="text-xs font-bold text-on-surface-variant">Total Active Unit Tajneed (Members)</label>
                                <input type="number" class="w-full rounded-xl border border-border-subtle p-3 text-sm focus:border-accent-gold focus:ring-4 focus:ring-gold-glow outline-none transition-all" min="0" @bind="Taleem.TotalMemberCount" disabled="@IsCycleLocked" />
                            </div>
                        </div>
                        
                        <div class="flex flex-col gap-1.5">
                            <label class="text-xs font-bold text-on-surface-variant">If attendance was below 75%, state specific reasons</label>
                            <textarea class="w-full rounded-xl border border-border-subtle p-3 text-sm focus:border-accent-gold focus:ring-4 focus:ring-gold-glow outline-none transition-all" rows="3" @bind="Taleem.BelowSeventyFiveReasons" placeholder="Explain external issues or local constraints..." disabled="@IsCycleLocked"></textarea>
                        </div>
                        
                        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                            <div class="flex flex-col gap-1.5">
                                <label class="text-xs font-bold text-on-surface-variant">Class Duration (Minutes)</label>
                                <input type="number" class="w-full rounded-xl border border-border-subtle p-3 text-sm focus:border-accent-gold focus:ring-4 focus:ring-gold-glow outline-none transition-all" min="0" @bind="Taleem.SessionDurationMinutes" disabled="@IsCycleLocked" />
                            </div>
                            <div class="flex flex-col gap-1.5">
                                <label class="text-xs font-bold text-on-surface-variant">Monthly Quran Test Takers</label>
                                <input type="number" class="w-full rounded-xl border border-border-subtle p-3 text-sm focus:border-accent-gold focus:ring-4 focus:ring-gold-glow outline-none transition-all" min="0" @bind="Taleem.MonthlyTestParticipants" disabled="@IsCycleLocked" />
                            </div>
                            <div class="flex flex-col gap-1.5">
                                <label class="text-xs font-bold text-on-surface-variant">Total Sessions Organised</label>
                                <input type="number" class="w-full rounded-xl border border-border-subtle p-3 text-sm focus:border-accent-gold focus:ring-4 focus:ring-gold-glow outline-none transition-all" min="0" @bind="Taleem.SessionsOrganized" disabled="@IsCycleLocked" />
                            </div>
                        </div>
                        
                        <div class="flex flex-col gap-1.5">
                            <label class="text-xs font-bold text-on-surface-variant">Additional Notes (Mosques / Locations details)</label>
                            <textarea class="w-full rounded-xl border border-border-subtle p-3 text-sm focus:border-accent-gold focus:ring-4 focus:ring-gold-glow outline-none transition-all" rows="3" @bind="Taleem.Notes" placeholder="Write additional context..." disabled="@IsCycleLocked"></textarea>
                        </div>
                    </div>
                }
                else if (_department == DepartmentType.Tabligh)
                {
                    <div class="flex flex-col gap-4">
                        <div class="flex flex-col gap-1.5">
                            <label class="text-xs font-bold text-on-surface-variant">Concise Description of Tabligh Activities</label>
                            <textarea class="w-full rounded-xl border border-border-subtle p-3 text-sm focus:border-accent-gold focus:ring-4 focus:ring-gold-glow outline-none transition-all" rows="4" @bind="Tabligh.ActivitiesDetails" placeholder="Detail street preachings, book handouts, or campus forums..." disabled="@IsCycleLocked"></textarea>
                        </div>
                        <div class="flex flex-col gap-1.5">
                            <label class="text-xs font-bold text-on-surface-variant">Outreach Purpose / Goal</label>
                            <textarea class="w-full rounded-xl border border-border-subtle p-3 text-sm focus:border-accent-gold focus:ring-4 focus:ring-gold-glow outline-none transition-all" rows="2" @bind="Tabligh.Purpose" placeholder="e.g. Cleansing misconceptions, invitations..." disabled="@IsCycleLocked"></textarea>
                        </div>
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                            <div class="flex flex-col gap-1.5">
                                <label class="text-xs font-bold text-on-surface-variant">Total Attendees Count</label>
                                <input type="number" class="w-full rounded-xl border border-border-subtle p-3 text-sm focus:border-accent-gold focus:ring-4 focus:ring-gold-glow outline-none transition-all" min="0" @bind="Tabligh.AttendeeCount" disabled="@IsCycleLocked" />
                            </div>
                            <div class="flex flex-col gap-1.5">
                                <label class="text-xs font-bold text-on-surface-variant">Primary Target Beneficiaries</label>
                                <input type="text" class="w-full rounded-xl border border-border-subtle p-3 text-sm focus:border-accent-gold focus:ring-4 focus:ring-gold-glow outline-none transition-all" @bind="Tabligh.Beneficiaries" placeholder="e.g. Non-muslims, students..." disabled="@IsCycleLocked" />
                            </div>
                        </div>
                        
                        @if (HasOnCampusActivityPreview)
                        {
                            <div class="p-3 bg-success-bg border border-success/20 rounded-xl text-success flex items-center gap-2 text-xs font-semibold">
                                <span class="material-symbols-outlined text-sm">school</span>
                                <span>On-campus activity detected from details field. Compliance flagged!</span>
                            </div>
                        }
                    </div>
                }
                else if (_department == DepartmentType.Welfare)
                {
                    <div class="flex flex-col gap-4">
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                            <div class="flex flex-col gap-1.5">
                                <label class="text-xs font-bold text-on-surface-variant">Welfare Programs Executed</label>
                                <input type="number" class="w-full rounded-xl border border-border-subtle p-3 text-sm focus:border-accent-gold focus:ring-4 focus:ring-gold-glow outline-none transition-all" min="0" @bind="Welfare.ProgramCount" disabled="@IsCycleLocked" />
                            </div>
                            <div class="flex flex-col gap-1.5">
                                <label class="text-xs font-bold text-on-surface-variant">Total Program Recipients / Participants</label>
                                <input type="number" class="w-full rounded-xl border border-border-subtle p-3 text-sm focus:border-accent-gold focus:ring-4 focus:ring-gold-glow outline-none transition-all" min="0" @bind="Welfare.ParticipantCount" disabled="@IsCycleLocked" />
                            </div>
                        </div>
                        <div class="flex flex-col gap-1.5">
                            <label class="text-xs font-bold text-on-surface-variant">Activities Timeline & Dates</label>
                            <textarea class="w-full rounded-xl border border-border-subtle p-3 text-sm focus:border-accent-gold focus:ring-4 focus:ring-gold-glow outline-none transition-all" rows="3" @bind="Welfare.ActivitiesWithDates" placeholder="List welfare items shared and specific dates..." disabled="@IsCycleLocked"></textarea>
                        </div>
                        <div class="flex flex-col gap-1.5">
                            <label class="text-xs font-bold text-on-surface-variant">Brief Report with Beneficiary feedback</label>
                            <textarea class="w-full rounded-xl border border-border-subtle p-3 text-sm focus:border-accent-gold focus:ring-4 focus:ring-gold-glow outline-none transition-all" rows="3" @bind="Welfare.BriefReportWithBeneficiaries" placeholder="Review specific outcomes..." disabled="@IsCycleLocked"></textarea>
                        </div>
                    </div>
                }
                else if (_department == DepartmentType.Sport)
                {
                    <div class="flex flex-col gap-4">
                        <div class="flex flex-col gap-1.5">
                            <label class="text-xs font-bold text-on-surface-variant">List Games & Physical Meets Hosted</label>
                            <textarea class="w-full rounded-xl border border-border-subtle p-3 text-sm focus:border-accent-gold focus:ring-4 focus:ring-gold-glow outline-none transition-all" rows="3" @bind="Sport.GamesParticipated" placeholder="e.g. Football matches, athletics, table tennis..." disabled="@IsCycleLocked"></textarea>
                        </div>
                        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                            <div class="flex flex-col gap-1.5">
                                <label class="text-xs font-bold text-on-surface-variant">Member Attendees</label>
                                <input type="number" class="w-full rounded-xl border border-border-subtle p-3 text-sm focus:border-accent-gold focus:ring-4 focus:ring-gold-glow outline-none transition-all" min="0" @bind="Sport.MemberParticipantCount" disabled="@IsCycleLocked" />
                            </div>
                            <div class="flex flex-col gap-1.5">
                                <label class="text-xs font-bold text-on-surface-variant">Non-Member Guests</label>
                                <input type="number" class="w-full rounded-xl border border-border-subtle p-3 text-sm focus:border-accent-gold focus:ring-4 focus:ring-gold-glow outline-none transition-all" min="0" @bind="Sport.NonMemberParticipantCount" disabled="@IsCycleLocked" />
                            </div>
                            <div class="flex flex-col gap-1.5">
                                <label class="text-xs font-bold text-on-surface-variant">Total Target Unit Tajneed</label>
                                <input type="number" class="w-full rounded-xl border border-border-subtle p-3 text-sm focus:border-accent-gold focus:ring-4 focus:ring-gold-glow outline-none transition-all" min="0" @bind="Sport.TotalMemberCount" disabled="@IsCycleLocked" />
                            </div>
                        </div>
                    </div>
                }
                else if (_department == DepartmentType.Finance)
                {
                    <div class="flex flex-col gap-4">
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                            <div class="flex flex-col gap-1.5">
                                <label class="text-xs font-bold text-on-surface-variant">AMSA Chanda Dues Generated (₦)</label>
                                <input type="number" class="w-full rounded-xl border border-border-subtle p-3 text-sm focus:border-accent-gold focus:ring-4 focus:ring-gold-glow outline-none transition-all" min="0" step="0.01" @bind="Finance.DuesCollected" disabled="@IsCycleLocked" />
                            </div>
                            <div class="flex flex-col gap-1.5">
                                <label class="text-xs font-bold text-on-surface-variant">Expected Target Dues Amount (₦)</label>
                                <input type="number" class="w-full rounded-xl border border-border-subtle p-3 text-sm focus:border-accent-gold focus:ring-4 focus:ring-gold-glow outline-none transition-all" min="0" step="0.01" @bind="Finance.ExpectedDues" disabled="@IsCycleLocked" />
                            </div>
                        </div>
                        <div class="flex flex-col gap-1.5">
                            <label class="text-xs font-bold text-on-surface-variant">Reasons for Payment Defaults (Chanda omissions)</label>
                            <textarea class="w-full rounded-xl border border-border-subtle p-3 text-sm focus:border-accent-gold focus:ring-4 focus:ring-gold-glow outline-none transition-all" rows="4" @bind="Finance.NonPaymentReasons" placeholder="e.g. Student financial difficulties, vacation period..." disabled="@IsCycleLocked"></textarea>
                        </div>
                    </div>
                }
                else if (_department == DepartmentType.Health)
                {
                    <div class="flex flex-col gap-4">
                        <div class="flex flex-col gap-1.5">
                            <label class="text-xs font-bold text-on-surface-variant">Details of Medical/Health Awareness Campaigns (include date)</label>
                            <textarea class="w-full rounded-xl border border-border-subtle p-3 text-sm focus:border-accent-gold focus:ring-4 focus:ring-gold-glow outline-none transition-all" rows="4" @bind="Health.HealthActivityWithDate" placeholder="Describe medical checks, lectures, runs and specific dates..." disabled="@IsCycleLocked"></textarea>
                        </div>
                        <div class="flex flex-col gap-1.5">
                            <label class="text-xs font-bold text-on-surface-variant">Total Health Beneficiary Count</label>
                            <input type="number" class="w-full rounded-xl border border-border-subtle p-3 text-sm focus:border-accent-gold focus:ring-4 focus:ring-gold-glow outline-none transition-all" min="0" @bind="Health.BeneficiaryCount" disabled="@IsCycleLocked" />
                        </div>
                    </div>
                }
                else if (_department == DepartmentType.SecondarySchool)
                {
                    <div class="flex flex-col gap-4">
                        <div class="flex flex-col gap-1.5">
                            <label class="text-xs font-bold text-on-surface-variant">Did you attend the last Circuit / Jama'at Executive Meeting?</label>
                            <select class="w-full rounded-xl border border-border-subtle p-3 text-sm focus:border-accent-gold focus:ring-4 focus:ring-gold-glow outline-none bg-surface-white transition-all cursor-pointer" @bind="SecondarySchool.AttendedLastJamaatAndCircuitMeeting" disabled="@IsCycleLocked">
                                <option value="true">Yes</option>
                                <option value="false">No</option>
                            </select>
                        </div>
                        <div class="flex flex-col gap-1.5">
                            <label class="text-xs font-bold text-on-surface-variant">If yes, what efforts were made to ensure parents' support?</label>
                            <textarea class="w-full rounded-xl border border-border-subtle p-3 text-sm focus:border-accent-gold focus:ring-4 focus:ring-gold-glow outline-none transition-all" rows="3" @bind="SecondarySchool.ParentSupportEfforts" placeholder="Detail visits, phone calls, or flyers..." disabled="@IsCycleLocked"></textarea>
                        </div>
                        <div class="flex flex-col gap-1.5">
                            <label class="text-xs font-bold text-on-surface-variant">AMSA activities involving jambites and secondary school students</label>
                            <textarea class="w-full rounded-xl border border-border-subtle p-3 text-sm focus:border-accent-gold focus:ring-4 focus:ring-gold-glow outline-none transition-all" rows="3" @bind="SecondarySchool.StudentActivities" placeholder="List tutorials, sport setups, or moral sessions..." disabled="@IsCycleLocked"></textarea>
                        </div>
                    </div>
                }
                else if (_department == DepartmentType.Tajneed)
                {
                    <div class="flex flex-col gap-4">
                        <div class="flex flex-col gap-1.5">
                            <label class="text-xs font-bold text-on-surface-variant">Do you maintain an updated and verified Tajneed database of all unit members?</label>
                            <select class="w-full rounded-xl border border-border-subtle p-3 text-sm focus:border-accent-gold focus:ring-4 focus:ring-gold-glow outline-none bg-surface-white transition-all cursor-pointer" @bind="Tajneed.HasAccurateUpdatedTajneed" disabled="@IsCycleLocked">
                                <option value="true">Yes</option>
                                <option value="false">No</option>
                            </select>
                        </div>
                        <div class="flex flex-col gap-1.5">
                            <label class="text-xs font-bold text-on-surface-variant">Operational census improvement efforts taken</label>
                            <textarea class="w-full rounded-xl border border-border-subtle p-3 text-sm focus:border-accent-gold focus:ring-4 focus:ring-gold-glow outline-none transition-all" rows="3" @bind="Tajneed.ImprovementEfforts" placeholder="Detail phone verification logs, home visits..." disabled="@IsCycleLocked"></textarea>
                        </div>
                        <div class="flex flex-col gap-1.5">
                            <label class="text-xs font-bold text-on-surface-variant">Active plans to ensure 100% census data integrity</label>
                            <textarea class="w-full rounded-xl border border-border-subtle p-3 text-sm focus:border-accent-gold focus:ring-4 focus:ring-gold-glow outline-none transition-all" rows="3" @bind="Tajneed.AccuracyPlans" placeholder="Outline digitisation steps, sync timelines..." disabled="@IsCycleLocked"></textarea>
                        </div>
                    </div>
                }
                else if (_department == DepartmentType.General)
                {
                    <div class="flex flex-col gap-4">
                        <div class="flex flex-col gap-1.5">
                            <label class="text-xs font-bold text-on-surface-variant">Highlight major operational challenges and proposed resolutions</label>
                            <textarea class="w-full rounded-xl border border-border-subtle p-3 text-sm focus:border-accent-gold focus:ring-4 focus:ring-gold-glow outline-none transition-all" rows="4" @bind="General.ChallengesAndResolutionPlan" placeholder="Explain details and how unit leadership can assist..." disabled="@IsCycleLocked"></textarea>
                        </div>
                        <div class="flex flex-col gap-1.5">
                            <label class="text-xs font-bold text-on-surface-variant">Brief overview of other miscellaneous events (include dates)</label>
                            <textarea class="w-full rounded-xl border border-border-subtle p-3 text-sm focus:border-accent-gold focus:ring-4 focus:ring-gold-glow outline-none transition-all" rows="4" @bind="General.OtherActivitiesWithDates" placeholder="Detail meetings, social gatherings, visits..." disabled="@IsCycleLocked"></textarea>
                        </div>
                    </div>
                }

                <div class="border-t border-border-subtle pt-4 flex flex-col gap-4">
                    <div class="flex flex-col gap-1.5">
                        <label class="text-xs font-bold text-on-surface-variant">Shared Additional Notes</label>
                        <textarea class="w-full rounded-xl border border-border-subtle p-3 text-sm focus:border-accent-gold focus:ring-4 focus:ring-gold-glow outline-none transition-all"
                                  rows="4"
                                  @bind="AdditionalNotes"
                                  placeholder="Add supporting notes that should travel with this department report through unit, state, and national review."
                                  disabled="@IsCycleLocked"></textarea>
                    </div>

                    <div class="flex flex-col gap-3 rounded-2xl border border-border-subtle bg-bg-cream p-4">
                        <div>
                            <h5 class="text-xs font-bold text-outline uppercase tracking-wider">Supporting Files</h5>
                            <p class="text-xs text-on-surface-variant mt-1">Allowed: PDF, Office docs, images, text files. Max 10 MB per file.</p>
                        </div>

                        <InputFile OnChange="HandleDepartmentAttachmentSelectedAsync" disabled="@IsCycleLocked" />

                        @if (DepartmentAttachments.Count == 0)
                        {
                            <div class="text-xs text-on-surface-variant">No supporting files uploaded yet.</div>
                        }
                        else
                        {
                            <div class="flex flex-col gap-2">
                                @foreach (var attachment in DepartmentAttachments)
                                {
                                    <div class="flex items-center justify-between rounded-xl bg-surface-white border border-border-subtle px-3 py-2">
                                        <div class="min-w-0">
                                            <div class="text-sm font-semibold text-on-surface truncate">@attachment.FileName</div>
                                            <div class="text-[11px] text-on-surface-variant">@attachment.ContentType · @FormatFileSize(attachment.FileSizeBytes)</div>
                                        </div>
                                        <button type="button"
                                                class="px-3 py-1.5 rounded-lg border border-danger/30 text-danger text-xs font-semibold hover:bg-danger hover:text-white transition-colors"
                                                @onclick="() => RemoveDepartmentAttachmentAsync(attachment.Id)"
                                                disabled="@IsCycleLocked">
                                            Remove
                                        </button>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
                
                <!-- Action Footer -->
                <div class="flex flex-wrap gap-3 border-t border-border-subtle pt-4 mt-2">
                    <button class="px-5 py-2.5 bg-surface-white border border-border-subtle hover:bg-surface-container-low text-primary rounded-xl font-bold text-xs shadow-sm cursor-pointer transition-colors" @onclick="SaveDraftAsync" disabled="@DisableActions">
                        Save Draft
                    </button>
                    <button class="px-5 py-2.5 bg-success hover:bg-primary text-white border-0 rounded-xl font-bold text-xs shadow-md cursor-pointer transition-all flex items-center gap-1.5" @onclick="SubmitDepartmentAsync" disabled="@DisableActions">
                        <span class="material-symbols-outlined text-[16px]">check_circle</span>
                        <span>Submit Department</span>
                    </button>
                    @if (CanSubmitFullReport)
                    {
                        <button class="px-5 py-2.5 bg-primary-deep hover:bg-primary text-white border-0 rounded-xl font-bold text-xs shadow-md cursor-pointer transition-all flex items-center gap-1.5" @onclick="SubmitFullReportAsync" disabled="@DisableActions">
                            <span class="material-symbols-outlined text-[16px]">publish</span>
                            <span>Submit Full Unit Report</span>
                        </button>
                    }
                </div>
            </div>
            
            <!-- Right Side: Compliance & Verification Panel (4 cols) -->
            <div class="lg:col-span-4 flex flex-col gap-6">
                <!-- Sync Auto Save Card -->
                <div class="bg-bg-cream rounded-2xl border border-border-subtle p-5 shadow-sm">
                    <h5 class="text-xs font-bold text-outline uppercase tracking-wider mb-2 flex items-center gap-1.5">
                        <span class="material-symbols-outlined text-sm animate-spin text-primary">sync</span>
                        <span>Amanah Sync Status</span>
                    </h5>
                    <p class="text-xs text-on-surface-variant leading-relaxed">
                        Form drafts are saved locally as you fill them. Click "Save Draft" to back up manually, or "Submit Department" to finalize.
                    </p>
                </div>

                <!-- Dynamic Compliance Engine -->
                <div class="bg-surface-white rounded-2xl border border-border-subtle p-5 shadow-sm flex flex-col gap-4">
                    <h5 class="text-xs font-bold text-outline uppercase tracking-wider border-b border-border-subtle pb-2 flex items-center gap-1.5">
                        <span class="material-symbols-outlined text-primary text-sm fill">verified</span>
                        <span>Compliance Evaluator</span>
                    </h5>
                    
                    @if (_department == DepartmentType.Taleem)
                    {
                        var attendanceCountVal = Taleem.AttendanceCount ?? 0;
                        var totalMemberCountVal = Taleem.TotalMemberCount ?? 0;
                        var attendanceRate = totalMemberCountVal == 0 ? 0 : (int)Math.Round((attendanceCountVal * 100.0) / totalMemberCountVal);
                        var mandatorySessions = Taleem.SessionsOrganized ?? 0;
                        var sessionsMet = mandatorySessions >= 4;
                        var attendanceMet = attendanceRate >= 75;
                        var colorClass = attendanceRate >= 75 ? "text-success bg-success-bg border-success/15" : attendanceRate >= 60 ? "text-warning bg-warning-bg border-warning/15" : "text-danger bg-danger-bg border-danger/20";
                        
                        
                        <div class="flex flex-col gap-4">
                            <!-- Sessions compliance -->
                            <div class="flex items-start gap-2.5">
                                <span class="material-symbols-outlined @(sessionsMet ? "text-success" : "text-warning")">
                                    @(sessionsMet ? "task_alt" : "hourglass_empty")
                                </span>
                                <div>
                                    <h6 class="text-xs font-bold text-on-surface">Study Circle Frequency</h6>
                                    <p class="text-[11px] text-on-surface-variant mt-0.5">@mandatorySessions of 4 mandatory sessions recorded.</p>
                                </div>
                            </div>
                            
                            <!-- Attendance progress circle -->
                            <div class="border rounded-xl p-4 flex items-center justify-between gap-3 @colorClass border">
                                <div>
                                    <h6 class="text-xs font-bold">Attendance Ratio</h6>
                                    <p class="text-[10px] opacity-90 mt-0.5">Calculated from total membership.</p>
                                </div>
                                <div class="text-right">
                                    <span class="text-xl font-extrabold">@attendanceRate%</span>
                                </div>
                            </div>
                            
                            <!-- Bottom alert -->
                            @if (sessionsMet && attendanceMet)
                            {
                                <div class="p-3 bg-success-bg border border-success/20 text-success text-[11px] rounded-lg font-bold leading-relaxed">
                                    Excellent Effort! Standard Ta'leem metrics successfully satisfied. Jazakumullah!
                                </div>
                            }
                            else
                            {
                                <div class="p-3 bg-warning-bg border border-warning/20 text-warning text-[11px] rounded-lg font-semibold leading-relaxed">
                                    If monthly attendance is under 75% or sessions are below 4, please provide solid reasons in the comments field.
                                </div>
                            }
                        </div>
                    }
                    else if (_department == DepartmentType.Finance)
                    {
                        var duesCollectedVal = Finance.DuesCollected ?? 0m;
                        var expectedDuesVal = Finance.ExpectedDues ?? 0m;
                        var collectionRate = expectedDuesVal == 0m ? 0 : (int)Math.Round((duesCollectedVal * 100m) / expectedDuesVal);
                        var rateMet = collectionRate >= 100;
                        var colorClass = rateMet ? "text-success bg-success-bg border-success/15" : "text-warning bg-warning-bg border-warning/15";
                        
                        
                        <div class="flex flex-col gap-4">
                            <div class="flex items-start gap-2.5">
                                <span class="material-symbols-outlined @(rateMet ? "text-success" : "text-warning")">
                                    @(rateMet ? "task_alt" : "hourglass_empty")
                                </span>
                                <div>
                                    <h6 class="text-xs font-bold text-on-surface">Target Collections Met</h6>
                                    <p class="text-[11px] text-on-surface-variant mt-0.5">Collection rate calculated from expected targets.</p>
                                </div>
                            </div>
                            
                            <div class="border rounded-xl p-4 flex items-center justify-between gap-3 @colorClass border">
                                <div>
                                    <h6 class="text-xs font-bold">Collections Rate</h6>
                                    <p class="text-[10px] opacity-90 mt-0.5">Dues collected vs Expected</p>
                                </div>
                                <div class="text-right">
                                    <span class="text-xl font-extrabold">@collectionRate%</span>
                                </div>
                            </div>
                        </div>
                    }
                    else if (_department == DepartmentType.Tabligh)
                    {
                        <div class="flex flex-col gap-3">
                            <div class="flex items-start gap-2.5">
                                <span class="material-symbols-outlined @(HasOnCampusActivityPreview ? "text-success" : "text-warning")">
                                    @(HasOnCampusActivityPreview ? "check_circle" : "info")
                                </span>
                                <div>
                                    <h6 class="text-xs font-bold text-on-surface">On-Campus Target</h6>
                                    <p class="text-[11px] text-on-surface-variant mt-0.5">Unit outreach programs must specify on-campus executions if applicable.</p>
                                </div>
                            </div>
                            <div class="p-3 bg-bg-cream rounded-xl border border-border-subtle text-[11px] text-on-surface-variant leading-relaxed">
                                Keyword search searches descriptions for "campus" identifiers to verify university student activities.
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="text-xs text-on-surface-variant leading-relaxed py-2 flex items-center gap-2">
                            <span class="material-symbols-outlined text-sm text-outline">help</span>
                            <span>Answer all questions honestly and concisely as part of your administrative Amanah.</span>
                        </div>
                    }
                </div>
            </div>
        </div>
    }
</div>

@code {
    [Parameter]
    public string DepartmentSlug { get; set; } = string.Empty;

    private bool IsLoading = true;
    private bool IsSaving;
    private int _reportId;
    private DepartmentType _department;
    private string DepartmentName = "";
    private string CycleLabel = "Active Cycle";
    private string DeadlineLabel = "-";
    private bool IsCycleLocked;
    private bool DepartmentSubmitted;
    private bool CanSubmitFullReport;
    private string? Message;
    private string MessageClass = "alert-info";
    private string? AdditionalNotes;
    private List<ReportAttachment> DepartmentAttachments { get; set; } = new();

    private TaleemForm Taleem { get; set; } = new();
    private TablighForm Tabligh { get; set; } = new();
    private WelfareForm Welfare { get; set; } = new();
    private SportForm Sport { get; set; } = new();
    private FinanceForm Finance { get; set; } = new();
    private HealthForm Health { get; set; } = new();
    private SecondarySchoolForm SecondarySchool { get; set; } = new();
    private TajneedForm Tajneed { get; set; } = new();
    private GeneralForm General { get; set; } = new();

    private bool DisableActions => IsSaving || IsCycleLocked;
    private bool HasOnCampusActivityPreview => Tabligh.ActivitiesDetails?.Contains("campus", StringComparison.OrdinalIgnoreCase) == true;

    protected override async Task OnParametersSetAsync()
    {
        if (!TryMapDepartment(DepartmentSlug, out _department))
        {
            Nav.NavigateTo("/dashboard");
            return;
        }

        DepartmentName = GetDepartmentTitle(_department);

        try
        {
            if (!CurrentUserReportService.CanEditOwnUnitDepartment(_department))
            {
                Nav.NavigateTo("/dashboard", replace: true);
                return;
            }

            CanSubmitFullReport = CurrentUserReportService.CanInitiateCurrentUserReportSubmission();

            var cycle = await CurrentUserReportService.EnsureActiveCycleAsync();
            CycleLabel = cycle.CycleMonth;
            DeadlineLabel = cycle.SubmissionDeadline.ToString("MMMM d, yyyy");
            IsCycleLocked = cycle.IsLocked || DateTime.UtcNow.Date > cycle.SubmissionDeadline.Date;

            var report = await CurrentUserReportService.GetCurrentUserDraftAsync(cycle.Id);
            if (report is null)
            {
                SetMessage("No draft report exists for the current cycle. Return to the dashboard and click Create Report first.", false);
                Nav.NavigateTo("/dashboard", replace: true);
                return;
            }

            if (report.Status is not ReportStatus.Draft and not ReportStatus.RejectedByPresident and not ReportStatus.RejectedByState)
            {
                SetMessage("This report is read-only after submission. Use the dashboard to review its status.", false);
                Nav.NavigateTo("/dashboard", replace: true);
                return;
            }

            _reportId = report.Id;

            var departmentReport = await CurrentUserReportService.GetDepartmentAsync(_reportId, _department);
            DepartmentSubmitted = departmentReport?.IsSubmitted == true;
            AdditionalNotes = departmentReport?.AdditionalNotes;
            DepartmentAttachments = [.. (departmentReport?.Attachments ?? [])];
            LoadDepartmentForm(departmentReport?.ReportData);
        }
        catch (Exception ex)
        {
            SetMessage(ex.Message, false);
        }
        finally
        {
            IsLoading = false;
        }
    }

    private async Task SaveDraftAsync()
    {
        await SaveInternalAsync(markSubmitted: false);
    }

    private async Task SubmitDepartmentAsync()
    {
        await SaveInternalAsync(markSubmitted: true);
    }

    private async Task SubmitFullReportAsync()
    {
        if (_reportId <= 0)
        {
            SetMessage("No report loaded.", false);
            return;
        }

        if (IsCycleLocked)
        {
            SetMessage("This cycle is locked and can no longer be submitted.", false);
            return;
        }

        IsSaving = true;
        try
        {
            await ReportingApiClient.SubmitReportAsync(_reportId, "Submitted from department editor");
            SetMessage("Report submitted to unit leadership.", true);
        }
        catch (Exception ex)
        {
            SetMessage(ex.Message, false);
        }
        finally
        {
            IsSaving = false;
        }
    }

    private async Task SaveInternalAsync(bool markSubmitted)
    {
        if (_reportId <= 0)
        {
            SetMessage("No report loaded.", false);
            return;
        }

        if (IsCycleLocked)
        {
            SetMessage("This cycle is locked and can no longer be edited.", false);
            return;
        }

        var validationError = ValidateCurrentForm();
        if (!string.IsNullOrWhiteSpace(validationError))
        {
            SetMessage(validationError, false);
            return;
        }

        IsSaving = true;
        try
        {
            var payload = DepartmentReportFormMapper.Serialize(_department, GetCurrentFormObject());
            await ReportingApiClient.SaveDepartmentAsync(_reportId, _department, payload, GetAdditionalNotes(), markSubmitted);
            DepartmentSubmitted = DepartmentSubmitted || markSubmitted;
            SetMessage(markSubmitted ? "Department submitted successfully." : "Draft saved successfully.", true);
        }
        catch (Exception ex)
        {
            SetMessage(ex.Message, false);
        }
        finally
        {
            IsSaving = false;
        }
    }

    private object GetCurrentFormObject() => _department switch
    {
        DepartmentType.Taleem => Taleem,
        DepartmentType.Tabligh => Tabligh,
        DepartmentType.Welfare => Welfare,
        DepartmentType.Sport => Sport,
        DepartmentType.Finance => Finance,
        DepartmentType.Health => Health,
        DepartmentType.SecondarySchool => SecondarySchool,
        DepartmentType.Tajneed => Tajneed,
        DepartmentType.General => General,
        _ => General
    };

    private string? GetAdditionalNotes() => _department switch
    {
        _ => string.IsNullOrWhiteSpace(AdditionalNotes) ? null : AdditionalNotes.Trim()
    };

    private async Task HandleDepartmentAttachmentSelectedAsync(InputFileChangeEventArgs args)
    {
        if (_reportId <= 0 || IsCycleLocked)
        {
            return;
        }

        var file = args.File;
        if (file is null)
        {
            return;
        }

        try
        {
            var attachment = await ReportingApiClient.AddDepartmentAttachmentAsync(_reportId, _department, file);
            DepartmentAttachments.Insert(0, attachment);
            SetMessage($"Attached {file.Name} successfully.", true);
        }
        catch (Exception ex)
        {
            SetMessage(ex.Message, false);
        }
    }

    private async Task RemoveDepartmentAttachmentAsync(int attachmentId)
    {
        try
        {
            await ReportingApiClient.RemoveDepartmentAttachmentAsync(attachmentId);
            DepartmentAttachments.RemoveAll(a => a.Id == attachmentId);
            SetMessage("Attachment removed.", true);
        }
        catch (Exception ex)
        {
            SetMessage(ex.Message, false);
        }
    }

    private static string FormatFileSize(long bytes)
    {
        if (bytes < 1024)
        {
            return $"{bytes} B";
        }

        if (bytes < 1024 * 1024)
        {
            return $"{bytes / 1024d:F1} KB";
        }

        return $"{bytes / 1024d / 1024d:F1} MB";
    }

    private void LoadDepartmentForm(string? reportData)
    {
        var form = DepartmentReportFormMapper.Deserialize(_department, reportData);
        switch (_department)
        {
            case DepartmentType.Taleem:
                Taleem = (TaleemForm)form;
                break;
            case DepartmentType.Tabligh:
                Tabligh = (TablighForm)form;
                break;
            case DepartmentType.Welfare:
                Welfare = (WelfareForm)form;
                break;
            case DepartmentType.Sport:
                Sport = (SportForm)form;
                break;
            case DepartmentType.Finance:
                Finance = (FinanceForm)form;
                break;
            case DepartmentType.Health:
                Health = (HealthForm)form;
                break;
            case DepartmentType.SecondarySchool:
                SecondarySchool = (SecondarySchoolForm)form;
                break;
            case DepartmentType.Tajneed:
                Tajneed = (TajneedForm)form;
                break;
            case DepartmentType.General:
                General = (GeneralForm)form;
                break;
        }
    }

    private string? ValidateCurrentForm()
    {
        return _department switch
        {
            DepartmentType.Taleem when Taleem.AttendanceCount < 0 || Taleem.TotalMemberCount < 0 || Taleem.SessionDurationMinutes < 0 || Taleem.MonthlyTestParticipants < 0 || Taleem.SessionsOrganized < 0
                => "Taleem numeric fields cannot be negative.",
            DepartmentType.Tabligh when Tabligh.AttendeeCount < 0
                => "Attendee count cannot be negative.",
            DepartmentType.Welfare when Welfare.ProgramCount < 0 || Welfare.ParticipantCount < 0
                => "Welfare numeric fields cannot be negative.",
            DepartmentType.Sport when Sport.MemberParticipantCount < 0 || Sport.NonMemberParticipantCount < 0 || Sport.TotalMemberCount < 0
                => "Sport numeric fields cannot be negative.",
            DepartmentType.Finance when Finance.DuesCollected < 0 || Finance.ExpectedDues < 0
                => "Finance amounts cannot be negative.",
            DepartmentType.Health when Health.BeneficiaryCount < 0
                => "Beneficiary count cannot be negative.",
            _ => null
        };
    }

    private void SetMessage(string message, bool success)
    {
        Message = message;
        MessageClass = success ? "alert-success" : "alert-danger";
    }

    private static bool TryMapDepartment(string slug, out DepartmentType department)
    {
        var normalized = slug?.Trim() ?? string.Empty;
        if (!Enum.TryParse(normalized, ignoreCase: true, out department))
        {
            return false;
        }

        return ReportDepartmentCatalog.ReportableDepartments.Contains(department);
    }

    private static string GetDepartmentTitle(DepartmentType department) => department switch
    {
        DepartmentType.Taleem => "Ta'leem (Education)",
        DepartmentType.Tabligh => "Tabligh (Outreach)",
        DepartmentType.Welfare => "Welfare (Amoomi)",
        DepartmentType.Sport => "Sport & Physical",
        DepartmentType.Finance => "Finance (Maal)",
        DepartmentType.Health => "Health & Medical",
        DepartmentType.SecondarySchool => "Secondary School",
        DepartmentType.Tajneed => "Tajneed (Census)",
        DepartmentType.General => "General & Challenges",
        _ => department.ToString()
    };

    private void BackToDashboard()
    {
        Nav.NavigateTo("/dashboard");
    }
}
