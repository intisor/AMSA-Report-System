@using AMSAReportingSystem.Core.Abstractions
@using AMSAReportingSystem.Data.Entities
@using AMSAReportingSystem.Services
@using Microsoft.AspNetCore.Components
@inject ReportingApiClient ReportingApiClient
@inject IOrganizationDirectory DirectoryLookupCache

<div class="container">
    @if (IsLoading)
    {
        <div class="alert alert-info">Loading national board...</div>
    }
    else
    {
        <div class="alert alert-info">
            <h5 class="alert-heading mb-1">National Board - @CycleLabel</h5>
            <p class="mb-0">Acknowledge reports submitted by states and monitor nationwide status.</p>
        </div>

        @if (!string.IsNullOrWhiteSpace(Message))
        {
            <div class="alert @MessageClass">@Message</div>
        }

        <div class="row mb-3">
            <div class="col-md-3"><strong>Total:</strong> @ReportsWithContext.Count</div>
            <div class="col-md-3"><strong>Awaiting National:</strong> @ReportsWithContext.Count(r => r.Status == ReportStatus.SubmittedToNational)</div>
            <div class="col-md-3"><strong>Acknowledged:</strong> @ReportsWithContext.Count(r => r.Status == ReportStatus.Acknowledged)</div>
            <div class="col-md-3"><strong>States:</strong> @ReportsWithContext.Select(r => r.StateId).Distinct().Count()</div>
        </div>

        <div class="card">
            <div class="card-header">
                <h5 class="mb-0">National Review Queue</h5>
            </div>
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead>
                        <tr>
                            <th>State</th>
                            <th>Unit</th>
                            <th>Status</th>
                            <th>Forwarded By State</th>
                            <th>State Context</th>
                            <th style="min-width: 260px;">National Note</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (ReportsWithContext.Count == 0)
                        {
                            <tr><td colspan="7" class="text-center text-muted py-4">No national reports found in this cycle.</td></tr>
                        }
                        else
                        {
                            @foreach (var report in ReportsWithContext)
                            {
                                var isExpanded = ExpandedReportIds.Contains(report.ReportId);
                                <tr>
                                    <td>@GetStateName(report.StateId)</td>
                                    <td>
                                        <button type="button" class="btn btn-link btn-sm text-decoration-none fw-bold px-0" @onclick="() => ToggleExpanded(report.ReportId)">
                                            <span class="me-1">@(isExpanded ? "▼" : "▶")</span><strong>@GetUnitName(report.UnitId)</strong>
                                        </button>
                                    </td>
                                    <td><span class="badge @GetStatusBadge(report.Status)">@report.Status</span></td>
                                    <td>@(report.ApprovedByStateAt?.ToString("yyyy-MM-dd HH:mm") ?? "-")</td>
                                    <td>
                                        @if (report.StateContext is not null)
                                        {
                                            <span class="badge bg-info">State reviewed</span>
                                            <br />
                                            <small class="text-muted">Units: @report.StateContext.UnitsAttendedTo/@report.StateContext.TotalUnitReportsCount</small>
                                            @if (!string.IsNullOrWhiteSpace(report.StateContext.AdditionalNotes))
                                            {
                                                <br />
                                                <small class="text-muted">Note: @report.StateContext.AdditionalNotes</small>
                                            }
                                            @if (report.StateContext.Attachments.Count > 0)
                                            {
                                                <br />
                                                <small class="text-muted">Attachments: @report.StateContext.Attachments.Count</small>
                                            }
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">No state context</span>
                                        }
                                    </td>
                                    <td>
                                        <input class="form-control form-control-sm"
                                               placeholder="Optional national note"
                                               @bind="NotesByReport[report.ReportId]" />
                                    </td>
                                    <td>
                                        @if (report.Status == ReportStatus.SubmittedToNational)
                                        {
                                            <button class="btn btn-sm btn-success" @onclick="() => Acknowledge(report.ReportId)">
                                                Acknowledge
                                            </button>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">No action</span>
                                        }
                                    </td>
                                </tr>

                                @if (isExpanded)
                                {
                                    <tr class="table-light">
                                        <td colspan="7">
                                            <div class="p-3">
                                                @if (report.StateContext is not null)
                                                {
                                                    <div class="border rounded p-3 bg-white mb-3">
                                                        <h6 class="fw-bold mb-2">State Report Context</h6>
                                                        <div class="small text-muted mb-2">@(string.IsNullOrWhiteSpace(report.StateContext.AdditionalNotes) ? "No shared state note." : report.StateContext.AdditionalNotes)</div>
                                                        @if (report.StateContext.Attachments.Count == 0)
                                                        {
                                                            <div class="small text-muted">No state attachments uploaded.</div>
                                                        }
                                                        else
                                                        {
                                                            <ul class="list-group list-group-flush">
                                                                @foreach (var attachment in report.StateContext.Attachments)
                                                                {
                                                                    <li class="list-group-item px-0">
                                                                        <div class="fw-semibold"><a href="@GetStateAttachmentDownloadUrl(attachment.Id)" target="_blank" rel="noopener noreferrer">@attachment.FileName</a></div>
                                                                        <div class="small text-muted">@attachment.ContentType · @FormatFileSize(attachment.FileSizeBytes)</div>
                                                                    </li>
                                                                }
                                                            </ul>
                                                        }
                                                    </div>
                                                }

                                                <div class="row g-3">
                                                    @foreach (var department in report.Departments.OrderBy(d => d.Department))
                                                    {
                                                        <div class="col-lg-6">
                                                            <div class="border rounded p-3 bg-white h-100">
                                                                <div class="d-flex justify-content-between align-items-center mb-2">
                                                                    <strong>@department.DepartmentName</strong>
                                                                    <span class="small text-muted">@department.Attachments.Count file(s)</span>
                                                                </div>
                                                                <div class="small text-muted mb-2">@(string.IsNullOrWhiteSpace(department.AdditionalNotes) ? "No shared department note." : department.AdditionalNotes)</div>
                                                                @if (department.Attachments.Count == 0)
                                                                {
                                                                    <div class="small text-muted">No attachments uploaded.</div>
                                                                }
                                                                else
                                                                {
                                                                    <ul class="list-group list-group-flush">
                                                                        @foreach (var attachment in department.Attachments)
                                                                        {
                                                                            <li class="list-group-item px-0">
                                                                                <div class="fw-semibold"><a href="@GetDepartmentAttachmentDownloadUrl(attachment.Id)" target="_blank" rel="noopener noreferrer">@attachment.FileName</a></div>
                                                                                <div class="small text-muted">@attachment.ContentType · @FormatFileSize(attachment.FileSizeBytes)</div>
                                                                            </li>
                                                                        }
                                                                    </ul>
                                                                }
                                                            </div>
                                                        </div>
                                                    }
                                                </div>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

@code {
    [Parameter]
    public AuthContext? CurrentUser { get; set; }

    private bool IsLoading = true;
    private string CycleLabel = "Active Cycle";
    private string? Message;
    private string MessageClass = "alert-info";
    private List<ReportWithStateContext> ReportsWithContext = new();
    private Dictionary<int, string> NotesByReport = new();
    private Dictionary<int, string> UnitNamesById = new();
    private Dictionary<int, string> StateNamesById = new();
    private HashSet<int> ExpandedReportIds = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        IsLoading = true;
        try
        {
            var cycle = await ReportingApiClient.GetActiveCycleAsync();
            CycleLabel = cycle.CycleMonth;
            ReportsWithContext = await ReportingApiClient.GetNationalReportsAsync(cycle.Id);
            NotesByReport = ReportsWithContext.ToDictionary(r => r.ReportId, _ => string.Empty);
            await WarmReportNamesAsync();
        }
        catch (Exception ex)
        {
            SetMessage(ex.Message, false);
        }
        finally
        {
            IsLoading = false;
        }
    }

    private async Task Acknowledge(int reportId)
    {
        try
        {
            var updated = await ReportingApiClient.AcknowledgeAtNationalAsync(reportId, NotesByReport.GetValueOrDefault(reportId));
            ReplaceReport(updated);
            SetMessage($"Report #{reportId} acknowledged by national leadership.", true);
        }
        catch (Exception ex)
        {
            SetMessage(ex.Message, false);
        }
    }

    private void ReplaceReport(Report updated)
    {
        var index = ReportsWithContext.FindIndex(r => r.ReportId == updated.Id);
        if (index >= 0)
        {
            // Create new composite view with updated report data
            var oldReport = ReportsWithContext[index];
            var newReport = new ReportWithStateContext(
                ReportId: updated.Id,
                UnitId: updated.UnitId,
                StateId: updated.StateId,
                CycleLabel: oldReport.CycleLabel,
                Status: updated.Status,
                CreatedAt: updated.CreatedAt,
                UpdatedAt: updated.UpdatedAt,
                SubmittedToPresidentAt: updated.SubmittedToPresidentAt,
                ApprovedByPresidentAt: updated.ApprovedByPresidentAt,
                PresidentialNotes: updated.PresidentialNotes,
                ApprovedByStateAt: updated.ApprovedByStateAt,
                StateNotes: updated.StateNotes,
                AcknowledgedByNationalAt: updated.AcknowledgedByNationalAt,
                NationalNotes: updated.NationalNotes,
                StateContext: oldReport.StateContext,
                Departments: oldReport.Departments,
                ActivityLogs: oldReport.ActivityLogs);
            
            ReportsWithContext[index] = newReport;
        }
        else
        {
            // If not found, reload the list
            _ = LoadAsync();
        }

        if (!NotesByReport.ContainsKey(updated.Id))
        {
            NotesByReport[updated.Id] = string.Empty;
        }
    }

    private void SetMessage(string text, bool success)
    {
        Message = text;
        MessageClass = success ? "alert-success" : "alert-danger";
    }

    private void ToggleExpanded(int reportId)
    {
        if (!ExpandedReportIds.Add(reportId))
        {
            ExpandedReportIds.Remove(reportId);
        }
    }

    private string GetUnitName(int unitId) =>
        UnitNamesById.TryGetValue(unitId, out var name) ? name : $"Unit {unitId}";

    private string GetStateName(int stateId) =>
        StateNamesById.TryGetValue(stateId, out var name) ? name : $"State {stateId}";

    private async Task WarmReportNamesAsync()
    {
        var unitIds = ReportsWithContext.Select(r => r.UnitId).Distinct().ToList();
        foreach (var unitId in unitIds)
        {
            UnitNamesById[unitId] = await DirectoryLookupCache.GetUnitNameAsync(unitId);
        }

        var stateIds = ReportsWithContext.Select(r => r.StateId).Distinct().ToList();
        foreach (var stateId in stateIds)
        {
            StateNamesById[stateId] = await DirectoryLookupCache.GetStateNameAsync(stateId);
        }
    }

    private static string GetDepartmentAttachmentDownloadUrl(int attachmentId) => $"/attachments/department/{attachmentId}";

    private static string GetStateAttachmentDownloadUrl(int attachmentId) => $"/attachments/state/{attachmentId}";

    private static string GetStatusBadge(ReportStatus status) => status switch
    {
        ReportStatus.Draft => "bg-secondary",
        ReportStatus.SubmittedToPresident => "bg-info",
        ReportStatus.RejectedByPresident => "bg-danger",
        ReportStatus.SubmittedToState => "bg-primary",
        ReportStatus.RejectedByState => "bg-danger",
        ReportStatus.SubmittedToNational => "bg-dark",
        ReportStatus.Acknowledged => "bg-success",
        _ => "bg-secondary"
    };

    private static string FormatFileSize(long bytes)
    {
        if (bytes < 1024)
        {
            return $"{bytes} B";
        }

        if (bytes < 1024 * 1024)
        {
            return $"{bytes / 1024d:F1} KB";
        }

        return $"{bytes / 1024d / 1024d:F1} MB";
    }
}

