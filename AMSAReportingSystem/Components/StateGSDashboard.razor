@using AMSAReportingSystem.Data.Entities
@using AMSAReportingSystem.Services
@inject CurrentUserReportService CurrentUserReportService

<div class="container">
    @if (IsLoading)
    {
        <div class="alert alert-info">Loading state reports...</div>
    }
    else
    {
        <div class="alert alert-info">
            <h5 class="alert-heading mb-1">State Reports - @CycleLabel</h5>
            <p class="mb-0">Review reports forwarded from unit leadership and prepare your state report for national.</p>
        </div>

        @if (!string.IsNullOrWhiteSpace(Message))
        {
            <div class="alert @MessageClass">@Message</div>
        }

        <div class="card mb-4">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5 class="mb-0">State-Level Monthly Report</h5>
                <span class="badge @(StateReportSubmitted ? "bg-success" : "bg-warning text-dark")">
                    @(StateReportSubmitted ? "Submitted To National" : "Draft")
                </span>
            </div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">Attendance of Unit Presidents in State meeting</label>
                        <div class="input-group">
                            <input type="number" min="0" class="form-control" @bind="StateForm.UnitPresidentsAttended" />
                            <span class="input-group-text">out of</span>
                            <input type="number" min="0" class="form-control" @bind="StateForm.TotalUnitPresidents" />
                        </div>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">How would you rate the performance of the units under you? (0-100)</label>
                        <input type="number" min="0" max="100" class="form-control" @bind="StateForm.UnitPerformanceRating" />
                    </div>

                    <div class="col-12">
                        <label class="form-label">How would you help them perform better?</label>
                        <textarea class="form-control" rows="3" @bind="StateForm.UnitImprovementPlan"></textarea>
                    </div>
                </div>

                <hr />

                <div class="d-flex justify-content-between align-items-center mb-2">
                    <h6 class="mb-0">State Programs / Activities</h6>
                    <button class="btn btn-sm btn-outline-primary" @onclick="AddProgram" disabled="@DisableStateFormActions">Add Program</button>
                </div>

                @if (StateForm.Programs.Count == 0)
                {
                    <div class="text-muted small mb-2">No programs added yet.</div>
                }
                else
                {
                    @for (var i = 0; i < StateForm.Programs.Count; i++)
                    {
                        var index = i;
                        <div class="border rounded p-3 mb-3">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <strong>Program @(i + 1)</strong>
                                <button class="btn btn-sm btn-outline-danger" @onclick="() => RemoveProgram(index)" disabled="@DisableStateFormActions">Remove</button>
                            </div>
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label class="form-label">Program Name</label>
                                    <input class="form-control" @bind="StateForm.Programs[i].ProgramName" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">Objectives</label>
                                    <input class="form-control" @bind="StateForm.Programs[i].Objectives" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">Outcomes</label>
                                    <input class="form-control" @bind="StateForm.Programs[i].Outcomes" />
                                </div>
                                <div class="col-md-3">
                                    <label class="form-label">Total Attendance</label>
                                    <input type="number" min="0" class="form-control" @bind="StateForm.Programs[i].TotalAttendance" />
                                </div>
                                <div class="col-md-3">
                                    <label class="form-label">Total Beneficiaries</label>
                                    <input type="number" min="0" class="form-control" @bind="StateForm.Programs[i].TotalBeneficiaries" />
                                </div>
                            </div>
                        </div>
                    }
                }

                <div class="mb-3">
                    <label class="form-label">Was there any challenge(s) faced? What were they and how do you plan to solve them?</label>
                    <textarea class="form-control" rows="3" @bind="StateForm.ChallengesFaced"></textarea>
                </div>

                <div class="mb-3">
                    <label class="form-label">How do you need the National to come in?</label>
                    <textarea class="form-control" rows="3" @bind="StateForm.NationalSupportNeeded"></textarea>
                </div>

                <div class="mb-3">
                    <label class="form-label">Give a brief and concise report of any other specific things worthy of note</label>
                    <textarea class="form-control" rows="3" @bind="StateForm.OtherNotes"></textarea>
                </div>

                @if (IsCycleLocked)
                {
                    <div class="alert alert-warning mb-3">
                        This cycle is locked. Deadline was @DeadlineLabel.
                    </div>
                }
            </div>
            <div class="card-footer d-flex gap-2">
                <button class="btn btn-primary" @onclick="SaveStateDraftAsync" disabled="@DisableStateFormActions">Save Draft</button>
                <button class="btn btn-success" @onclick="SubmitStateReportAsync" disabled="@DisableStateFormActions">Submit State Report</button>
            </div>
        </div>

        <div class="row mb-3">
            <div class="col-md-3"><strong>Total:</strong> @Reports.Count</div>
            <div class="col-md-3"><strong>Needs Review:</strong> @Reports.Count(r => r.Status == ReportStatus.SubmittedToState)</div>
            <div class="col-md-3"><strong>Forwarded:</strong> @Reports.Count(r => r.Status == ReportStatus.SubmittedToNational)</div>
            <div class="col-md-3"><strong>Rejected:</strong> @Reports.Count(r => r.Status == ReportStatus.RejectedByState)</div>
        </div>

        <div class="card">
            <div class="card-header">
                <h5 class="mb-0">State Review Queue</h5>
            </div>
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead>
                        <tr>
                            <th>Unit</th>
                            <th>Status</th>
                            <th>Forwarded By Unit</th>
                            <th>Submitted Departments</th>
                            <th style="min-width: 240px;">State Note</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Reports.Count == 0)
                        {
                            <tr><td colspan="6" class="text-center text-muted py-4">No reports found for your state in this cycle.</td></tr>
                        }
                        else
                        {
                            @foreach (var report in Reports)
                            {
                                var submitted = report.DepartmentReports.Count(d => d.IsSubmitted);
                                <tr>
                                    <td><strong>@report.Unit.Name</strong></td>
                                    <td><span class="badge @GetStatusBadge(report.Status)">@report.Status</span></td>
                                    <td>@(report.ApprovedByPresidentAt?.ToString("yyyy-MM-dd HH:mm") ?? "-")</td>
                                    <td>@submitted / @report.DepartmentReports.Count</td>
                                    <td>
                                        <input class="form-control form-control-sm"
                                               placeholder="Optional state note"
                                               @bind="NotesByReport[report.Id]" />
                                    </td>
                                    <td>
                                        @if (report.Status == ReportStatus.SubmittedToState)
                                        {
                                            <div class="d-flex gap-2">
                                                <button class="btn btn-sm btn-success" @onclick="() => Approve(report.Id)">Approve + Forward</button>
                                                <button class="btn btn-sm btn-outline-danger" @onclick="() => Reject(report.Id)">Reject</button>
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">No action</span>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

@code {
    [Parameter]
    public AuthContext? CurrentUser { get; set; }

    private bool IsLoading = true;
    private bool IsSavingStateForm;
    private bool IsCycleLocked;
    private bool StateReportSubmitted;
    private string CycleLabel = "Active Cycle";
    private string DeadlineLabel = "-";
    private string? Message;
    private string MessageClass = "alert-info";
    private List<Report> Reports = new();
    private Dictionary<int, string> NotesByReport = new();
    private StateReportForm StateForm = new();
    private int StateReportId;
    private bool DisableStateFormActions => IsSavingStateForm || IsCycleLocked || StateReportSubmitted;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        IsLoading = true;
        try
        {
            var cycle = await CurrentUserReportService.EnsureActiveCycleAsync();
            CycleLabel = cycle.CycleMonth;
            DeadlineLabel = cycle.SubmissionDeadline.ToString("MMMM d, yyyy");
            IsCycleLocked = cycle.IsLocked || DateTime.UtcNow.Date > cycle.SubmissionDeadline.Date;

            Reports = await CurrentUserReportService.GetMyStateReportsAsync(cycle.Id);
            NotesByReport = Reports.ToDictionary(r => r.Id, _ => string.Empty);

            var stateReport = await CurrentUserReportService.EnsureMyStateReportAsync(cycle.Id);
            StateReportId = stateReport.Id;
            StateReportSubmitted = stateReport.Status is ReportStatus.SubmittedToNational or ReportStatus.Acknowledged;
            StateForm = StateReportFormMapper.ToForm(stateReport);
            if (StateForm.Programs.Count == 0)
            {
                StateForm.Programs.Add(new StateProgramForm());
            }
        }
        catch (Exception ex)
        {
            SetMessage(ex.Message, false);
        }
        finally
        {
            IsLoading = false;
        }
    }

    private async Task SaveStateDraftAsync()
    {
        await SaveStateAsync(markSubmitted: false);
    }

    private async Task SubmitStateReportAsync()
    {
        await SaveStateAsync(markSubmitted: true);
    }

    private async Task SaveStateAsync(bool markSubmitted)
    {
        if (DisableStateFormActions || StateReportId <= 0)
        {
            return;
        }

        IsSavingStateForm = true;
        try
        {
            StateForm.StateReportId = StateReportId;
            var saved = await CurrentUserReportService.SaveMyStateReportAsync(StateReportId, StateForm, markSubmitted);
            StateForm = StateReportFormMapper.ToForm(saved);
            if (StateForm.Programs.Count == 0)
            {
                StateForm.Programs.Add(new StateProgramForm());
            }

            StateReportSubmitted = saved.Status is ReportStatus.SubmittedToNational or ReportStatus.Acknowledged;
            SetMessage(markSubmitted ? "State report submitted to national." : "State report draft saved.", true);
        }
        catch (Exception ex)
        {
            SetMessage(ex.Message, false);
        }
        finally
        {
            IsSavingStateForm = false;
        }
    }

    private void AddProgram()
    {
        StateForm.Programs.Add(new StateProgramForm());
    }

    private void RemoveProgram(int index)
    {
        if (index < 0 || index >= StateForm.Programs.Count)
        {
            return;
        }

        StateForm.Programs.RemoveAt(index);
        if (StateForm.Programs.Count == 0)
        {
            StateForm.Programs.Add(new StateProgramForm());
        }
    }

    private async Task Approve(int reportId)
    {
        try
        {
            await CurrentUserReportService.ApproveAtStateAsync(reportId, NotesByReport.GetValueOrDefault(reportId));
            SetMessage($"Report #{reportId} approved and forwarded to national.", true);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            SetMessage(ex.Message, false);
        }
    }

    private async Task Reject(int reportId)
    {
        try
        {
            await CurrentUserReportService.RejectAtStateAsync(reportId, NotesByReport.GetValueOrDefault(reportId));
            SetMessage($"Report #{reportId} rejected at state level.", true);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            SetMessage(ex.Message, false);
        }
    }

    private void SetMessage(string text, bool success)
    {
        Message = text;
        MessageClass = success ? "alert-success" : "alert-danger";
    }

    private static string GetStatusBadge(ReportStatus status) => status switch
    {
        ReportStatus.Draft => "bg-secondary",
        ReportStatus.SubmittedToPresident => "bg-info",
        ReportStatus.RejectedByPresident => "bg-danger",
        ReportStatus.SubmittedToState => "bg-primary",
        ReportStatus.RejectedByState => "bg-danger",
        ReportStatus.SubmittedToNational => "bg-dark",
        ReportStatus.Acknowledged => "bg-success",
        _ => "bg-secondary"
    };
}
