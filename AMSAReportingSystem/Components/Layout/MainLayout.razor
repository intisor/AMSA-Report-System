@inherits LayoutComponentBase
@using AMSAReportingSystem.Services
@inject AMSAApiConnectionStatus ApiStatus

<div class="d-flex flex-column min-vh-100">
    <!-- Navigation -->
    <nav class="navbar navbar-expand-lg navbar-dark site-nav">
        <div class="container-fluid">
            <a class="navbar-brand fw-bold" href="/">
                <span style="font-size: 1.5rem; margin-right: 10px;">📋</span>
                <strong>AMSA</strong> Reporting
            </a>
            <span class="badge @GetAmsaBadgeClass() me-3">@GetAmsaBadgeText()</span>
            <button class="navbar-toggler" type="button" @onclick="ToggleNavMenu">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse @(IsNavMenuOpen ? "show" : string.Empty)" id="navbarNav">
                <NavMenu />
            </div>
        </div>
    </nav>

    <!-- Main Content -->
    <main class="flex-grow-1 page-surface">
        <article>
            @Body
        </article>
    </main>

    <!-- Footer -->
    <footer class="bg-light text-center py-3 mt-5 border-top">
        <div class="container text-muted small">
            <p class="mb-0">© 2025 Ahmadi Muslim Students' Association of Nigeria (AMSA) Reporting System</p>
        </div>
    </footer>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private bool IsNavMenuOpen;

    private void ToggleNavMenu()
    {
        IsNavMenuOpen = !IsNavMenuOpen;
    }

    private string GetAmsaBadgeText()
    {
        if (!ApiStatus.IsChecked)
        {
            return "Checking AMSA API...";
        }

        return ApiStatus.IsConnected ? "Connected to AMSA API" : "AMSA API unavailable";
    }

    private string GetAmsaBadgeClass()
    {
        if (!ApiStatus.IsChecked)
        {
            return "bg-secondary";
        }

        return ApiStatus.IsConnected ? "bg-success" : "bg-danger";
    }
}
