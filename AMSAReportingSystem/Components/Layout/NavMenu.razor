@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@using AMSAReportingSystem.Services
@using AMSAReportingSystem.Data.Entities
@inject AuthenticationStateProvider AuthStateProvider
@inject ReportAccessService ReportAccessService
@inject NavigationManager Nav

<ul class="flex flex-col md:flex-row items-stretch md:items-center gap-4 md:gap-6 list-none p-0 m-0 w-full md:w-auto">
    @if (CurrentUser?.IsAuthenticated ?? false)
    {
        <li class="flex items-center">
            <a class="text-on-primary/80 hover:text-on-primary font-label-md text-label-md transition-all duration-300 no-underline py-2 md:py-0" href="/dashboard">Dashboard</a>
        </li>

        @if (!string.IsNullOrWhiteSpace(MyReportLink))
        {
            <li class="flex items-center">
                <a class="text-on-primary/80 hover:text-on-primary font-label-md text-label-md transition-all duration-300 no-underline py-2 md:py-0" href="@MyReportLink">My Report</a>
            </li>
        }

        <li class="relative flex items-center">
            <button class="text-tertiary-fixed font-label-md text-label-md flex items-center gap-2 hover:opacity-90 transition-all no-underline py-2 md:py-0 bg-transparent border-0 cursor-pointer w-full text-left" id="userMenu" aria-expanded="@IsUserMenuOpen" @onclick="ToggleUserMenu" @onclick:preventDefault="true">
                <strong>@CurrentUser?.FirstName</strong>
                <span class="bg-surface-white text-primary px-2.5 py-0.5 rounded-full text-xs font-bold shadow-sm">@GetRoleLabel()</span>
                <span class="material-symbols-outlined text-[18px]">arrow_drop_down</span>
            </button>
            @if (IsUserMenuOpen)
            {
                <div class="absolute right-0 top-10 md:top-12 mt-2 w-52 bg-surface-white rounded-xl shadow-lg border border-border-subtle z-50 flex flex-col p-2 animate-fadeIn">
                    <span class="px-4 py-2 text-xs font-bold uppercase tracking-wider text-outline">@CurrentUser?.FullName</span>
                    <hr class="border-border-subtle my-1">
                    <button class="px-4 py-2.5 text-left text-sm text-on-surface-variant font-medium hover:bg-surface-container-low rounded-lg transition-colors bg-transparent border-0 w-full cursor-pointer" @onclick="LogoutAsync">
                        <span class="material-symbols-outlined text-sm mr-2 align-middle">logout</span>
                        <span class="align-middle">Logout</span>
                    </button>
                </div>
            }
        </li>
    }
    else
    {
        <li class="flex items-center">
            <a class="border border-on-primary text-on-primary hover:bg-on-primary hover:text-primary px-4 py-2 rounded-lg font-label-md text-label-md transition-all duration-300 no-underline text-center w-full md:w-auto" href="/login">Login</a>
        </li>
    }
</ul>

@code {
    private AuthContext? CurrentUser;
    private string? MyReportLink;
    private bool IsUserMenuOpen;

    protected override void OnInitialized()
    {
        var amsaProvider = (AMSAAuthStateProvider)AuthStateProvider;
        CurrentUser = amsaProvider.GetCurrentUser();
        MyReportLink = ResolveMyReportLink(CurrentUser);
    }

    private async Task LogoutAsync(MouseEventArgs e)
    {
        IsUserMenuOpen = false;
        var amsaProvider = (AMSAAuthStateProvider)AuthStateProvider;
        await amsaProvider.LogoutAsync();
        Nav.NavigateTo("/login", forceLoad: true);
    }

    private void ToggleUserMenu(MouseEventArgs _)
    {
        IsUserMenuOpen = !IsUserMenuOpen;
    }

    private string GetRoleLabel()
    {
        if (CurrentUser?.IsNationalLeadership ?? false)
            return "National";
        if (CurrentUser?.IsStateLeadership ?? false)
            return "State";
        if (CurrentUser?.IsUnitLeadership ?? false)
            return "Unit";
        if (CurrentUser?.IsDepartmentOfficer ?? false)
            return "Officer";
        return "User";
    }

    private string? ResolveMyReportLink(AuthContext? user)
    {
        if (user is null || !user.IsAuthenticated)
        {
            return null;
        }

        foreach (var department in ReportDepartmentCatalog.ReportableDepartments)
        {
            if (ReportAccessService.CanEditDepartment(user, user.UnitId, user.StateId, department))
            {
                return $"/report/{department.ToString().ToLowerInvariant()}";
            }
        }

        return null;
    }
}
