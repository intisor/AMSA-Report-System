@using AMSAReportingSystem.Data.Entities
@using AMSAReportingSystem.Services
@inject CurrentUserReportService CurrentUserReportService

<div class="container">
    @if (IsLoading)
    {
        <div class="alert alert-info">Loading unit reports...</div>
    }
    else
    {
        <div class="row mb-3">
            <div class="col-md-12">
                <div class="card">
                    <div class="card-header bg-success text-white">
                        <h5 class="mb-0">Unit Reports - @CycleLabel</h5>
                    </div>
                    <div class="card-body">
                        <div class="d-flex gap-4">
                            <div><strong>Total:</strong> @Reports.Count</div>
                            <div><strong>Submitted:</strong> @Reports.Count(r => r.Status == ReportStatus.SubmittedToPresident)</div>
                            <div><strong>Forwarded:</strong> @Reports.Count(r => r.Status == ReportStatus.SubmittedToState)</div>
                            <div><strong>Rejected:</strong> @Reports.Count(r => r.Status == ReportStatus.RejectedByPresident)</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(Message))
        {
            <div class="alert @MessageClass">@Message</div>
        }

        <div class="card">
            <div class="card-header">
                <h5 class="mb-0">Review Queue</h5>
            </div>
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead>
                        <tr>
                            <th>Report Id</th>
                            <th>Status</th>
                            <th>Submitted</th>
                            <th>Departments</th>
                            <th style="min-width: 260px;">Notes</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Reports.Count == 0)
                        {
                            <tr><td colspan="6" class="text-center text-muted py-4">No reports yet for this cycle.</td></tr>
                        }
                        else
                        {
                            @foreach (var report in Reports)
                            {
                                var submittedDepartments = report.DepartmentReports.Count(d => d.IsSubmitted);
                                <tr>
                                    <td><strong>#@report.Id</strong></td>
                                    <td><span class="badge @GetStatusBadge(report.Status)">@report.Status</span></td>
                                    <td>@(report.SubmittedToPresidentAt?.ToString("yyyy-MM-dd HH:mm") ?? "-")</td>
                                    <td>@submittedDepartments / @report.DepartmentReports.Count</td>
                                    <td>
                                        <input class="form-control form-control-sm"
                                               placeholder="Optional note"
                                               @bind="NotesByReport[report.Id]" />
                                    </td>
                                    <td>
                                        @if (report.Status == ReportStatus.SubmittedToPresident)
                                        {
                                            <div class="d-flex gap-2">
                                                <button class="btn btn-sm btn-success" @onclick="() => Approve(report.Id)">Approve + Forward</button>
                                                <button class="btn btn-sm btn-outline-danger" @onclick="() => Reject(report.Id)">Reject</button>
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">No action</span>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

@code {
    [Parameter]
    public AuthContext? CurrentUser { get; set; }

    private bool IsLoading = true;
    private string CycleLabel = "Active Cycle";
    private string? Message;
    private string MessageClass = "alert-info";
    private List<Report> Reports = new();
    private Dictionary<int, string> NotesByReport = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        IsLoading = true;
        try
        {
            var cycle = await CurrentUserReportService.EnsureActiveCycleAsync();
            CycleLabel = cycle.CycleMonth;
            Reports = await CurrentUserReportService.GetMyUnitReportsAsync(cycle.Id);
            NotesByReport = Reports.ToDictionary(r => r.Id, _ => string.Empty);
        }
        catch (Exception ex)
        {
            SetMessage(ex.Message, false);
        }
        finally
        {
            IsLoading = false;
        }
    }

    private async Task Approve(int reportId)
    {
        try
        {
            await CurrentUserReportService.ApproveAtUnitAsync(reportId, NotesByReport.GetValueOrDefault(reportId));
            SetMessage($"Report #{reportId} approved and forwarded to state.", true);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            SetMessage(ex.Message, false);
        }
    }

    private async Task Reject(int reportId)
    {
        try
        {
            await CurrentUserReportService.RejectAtUnitAsync(reportId, NotesByReport.GetValueOrDefault(reportId));
            SetMessage($"Report #{reportId} rejected to unit officer(s).", true);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            SetMessage(ex.Message, false);
        }
    }

    private void SetMessage(string text, bool success)
    {
        Message = text;
        MessageClass = success ? "alert-success" : "alert-danger";
    }

    private static string GetStatusBadge(ReportStatus status) => status switch
    {
        ReportStatus.Draft => "bg-secondary",
        ReportStatus.SubmittedToPresident => "bg-info",
        ReportStatus.RejectedByPresident => "bg-danger",
        ReportStatus.SubmittedToState => "bg-primary",
        ReportStatus.RejectedByState => "bg-danger",
        ReportStatus.SubmittedToNational => "bg-dark",
        ReportStatus.Acknowledged => "bg-success",
        _ => "bg-secondary"
    };
}
